import("//build/buildflag_header.gni")
import("//enterprise_browser/build/enterprise_browser.gni")

buildflag_header("enterprise_browser_buildflags") {
  header = "enterprise_browser_buildflags.h"
  flags = [ "IS_ENTERPRISE_BROWSER=$is_enterprise_browser" ]
}

config("enterprise_browser_defines") {
  if (is_enterprise_browser) {
    defines = [ "ENTERPRISE_BROWSER=1" ]
  }
}
