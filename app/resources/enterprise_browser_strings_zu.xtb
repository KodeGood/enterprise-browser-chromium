<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="1029669172902658969">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromiumOS</translation>
<translation id="103359417695385097">IEnterprise Browser iwaqonda kangcono amafomu futhi ingakugcwalisela wona ngokuzenzekelayo ngokushesha. Leli sethingi livaliwe.</translation>
<translation id="1040916596585577953">I-Enterprise Browser incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="1042552502243217427">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Enterprise Browser isebenzisa amaseva e-Google. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Google ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="1051793555070215510">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="1083934481477628225">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Enterprise Browser</translation>
<translation id="1104942323762546749">I-Enterprise Browser ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">I-Enterprise Browser iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Chofoza imenyu ye-Enterprise Browser</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="1171831736360285680">U-<ph name="PARTNER_NAME" /> wengeze isandiso esingaguqula indlela iEnterprise Browser esebenza ngayo.

<ph name="EXTENSION_NAME" /></translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="1185134272377778587">Mayelana ne-Enterprise Browser</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME" />.</translation>
<translation id="123265588161106468">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeGoogle Account yakho kuEnterprise Browser. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuEnterprise Browser”.</translation>
<translation id="1262876892872089030">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Enterprise Browser ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="1265577313130862557">I-Enterprise Browser ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="126567311906253476">Uma ungena ngemvume kumasevisi eGoogle efana neGmail noma iYouTube nge-<ph name="USER_EMAIL" />, ungangena ngemvume ngokuzenzakalela kuEnterprise Browser nge-akhawunti efanayo</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Setha iphrofayela yakho entsha ye-Enterprise Browser</translation>
<translation id="1324107359134968521">I-Enterprise Browser idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="1342274909142618978">Futhi sula idatha ku-Enterprise Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1356661055722410047">Okusha! Ungahumusha kokubili umbhalo nezithombe esikrinini sakho</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="1397530502368084401">&amp;Lawula Amaphrofayela eEnterprise Browser</translation>
<translation id="1414495520565016063">Ungene ngemvume ku-Enterprise Browser!</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="1465192221147974788">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweEnterprise Browser Kumasethingi Ohlelo.</translation>
<translation id="1478370723027452770">Thola usizo nge-Enterprise Browser Yokuhlola</translation>
<translation id="1496875977627931224">Sawubona <ph name="USER_NAME" />,<ph name="LINE_BREAK" />yini oyicabangayo namuhla?</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="1524282610922162960">Yabelana ngethebhu ye-Enterprise Browser</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="1553461853655228091">I-Enterprise Browser idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Lesi sandiso asisasekelwa. IEnterprise Browser incoma ukuthi usisuse.}one{Lezi zandiso azisasekelwa. IEnterprise Browser incoma ukuthi uzisuse.}other{Lezi zandiso azisasekelwa. IEnterprise Browser incoma ukuthi uzisuse.}}</translation>
<translation id="1562320819937089394">Phina iEnterprise Browser</translation>
<translation id="1574377791422810894">Amathuluzi okuphepha e-Enterprise Browser</translation>
<translation id="1594928384848033697">IEnterprise Browser ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="1625909126243026060">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Enterprise Browser</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1680687534629375545">Buza Ukusesha Ngezithombe ngaleli khasi</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME" />.</translation>
<translation id="1715127912119967311">Ukusiza ukuthuthukisa lezi zici, i-Enterprise Browser ithumela ukusebenzisana kwakho nazo ku-Google. Le datha ingase ifundwe, icutshungulwe, futhi ichazwe ababuyekezi abangabantu.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="1733725117201708356">I-Enterprise Browser izosula idatha yokubhrawuza maduze</translation>
<translation id="1736443181683099871">I-Enterprise Browser izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="1736662517232558588">Idatha ye-Enterprise Browser esuliwe</translation>
<translation id="1745121272106313518">I-Enterprise Browser izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Uma i-HTTPS ingatholakali, i-Enterprise Browser izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="1774152462503052664">Vumela i-Enterprise Browser ukuthi isebenze ngemuva</translation>
<translation id="1779356040007214683">Ukuze senze i-Enterprise Browser ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1808667845054772817">Phinda ufake i-Enterprise Browser</translation>
<translation id="1820835682567584003">I-Enterprise Browser izama uku-<ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Ngokuzayo uma uvula iEnterprise Browser ku-<ph name="DEVICE_TYPE" /> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeGoogle.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="18552579716432081">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Google Account yakho, <ph name="BEGIN_LINK" />phuma ngemvume ku-Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Ungaphatha ama-akhawunti we-Google wakho angene ngemvume. Ama-akhawunti wakho we-Google asetshenziselwe i-browser ye-Enterprise Browser, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE" /> yakho kunalokho. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="1881322772814446296">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Enterprise Browser. Idatha yakho ye-Enterprise Browser, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Enterprise Browser ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">IEnterprise Browser igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK" /></translation>
<translation id="1898804291554630487">Buza mayelana naleli khasi</translation>
<translation id="1900969832270057921">Isevisi Yesibuyekezi SeEnterprise Browser</translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Enterprise Browser</translation>
<translation id="1929939181775079593">I-Enterprise Browser ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="1933341829955786215">Inhlangano yakho, ebizwa <ph name="MANAGER" />, ifuna ungene ngemvume kuEnterprise Browser</translation>
<translation id="193439633299369377">I-ChromiumOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="1951406923938785464">I-Enterprise Browser ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE" /></translation>
<translation id="1966382378801805537">I-Enterprise Browser ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="1990262977744080398">Funda ukuthi kungani i-Enterprise Browser ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="1999715455684970349">Kugcina isofthiwe yakho yeEnterprise Browser ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeEnterprise Browser ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeEnterprise Browser eyisebenzisayo.</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Enterprise Browser njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="2020032459870799438">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="2049376729098081731">Khetha ukuthi ufake phakathi umlando we-Enterprise Browser ukuze uthole umuzwa womuntu siqu kumasevisi e-Google</translation>
<translation id="2054039611381840095">Ukuze uthole izibuyekezo ezizayo zeEnterprise Browser, uzodinga i-macOS 12 noma eyakamuva. Le khompyutha isebenzisa i-macOS 11.</translation>
<translation id="2064856577282482477">Chofoza inkinobho ethi Vumelanisa IEnterprise Browser Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iEnterprise Browser ukubukeka okusha</translation>
<translation id="2086476982681781442">I-Enterprise Browser ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="208726765006323911">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME" /> ngesikhathi esilandelayo lapho uvula iEnterprise Browser iOS.</translation>
<translation id="2099452623287920103">Amaphasiwedi akho kanye nenye idatha yeEnterprise Browser oyilondoloze kuGoogle Account yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuEnterprise Browser, ngena ngemvume futhi.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Enterprise Browser ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Enterprise Browser ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Enterprise Browser ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2137162749895930932">Vala isikrini sokuhumusha</translation>
<translation id="215352261310130060">I-Enterprise Browser ivimbele lokhu kulanda ngoba isayithi alisebenzisi uxhumano oluvikelekile futhi kungenzeka ukuthi ifayela lonaniwe.</translation>
<translation id="2174178932569897599">Yenza i-Enterprise Browser ngokwezifiso</translation>
<translation id="2174917724755363426">Ukufaka akuqediwe. Uqinisekile ufuna ukukhansela?</translation>
<translation id="2185166961232948079">I-Enterprise Browser - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Buyekeza iphutha lokuchekha: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Susa i-akhawunti kuEnterprise Browser</translation>
<translation id="2210502920229141283">Hlala uphephile lapho usendleleni Ngokubhrawuza Okuphephe Ngokuthuthukisiwe kuEnterprise Browser ye-iOS</translation>
<translation id="2210682093923538346">Isayithi eyingozi. I-Enterprise Browser isuse izaziso.</translation>
<translation id="2236949375853147973">Umsebenzi Wami</translation>
<translation id="2238130810669087193">Ukuze uthole amakheli akho nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuEnterprise Browser. Leli kheli lizolondolozwa kuGoogle Account yakho ngemva kokungena ngemvume.</translation>
<translation id="2241627712206172106">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Enterprise Browser ngendlela abafuna ngayo nje.</translation>
<translation id="2283803047247799269">Sesha le thebhu Ngosesho Lomfanekiso</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{IEnterprise Browser incoma ukumisa ithebhu enciphisa ijubane lebhrawuza yakho}one{IEnterprise Browser incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}other{IEnterprise Browser incoma ukumisa amathebhu anciphisa ijubane lebhrawuza yakho}}</translation>
<translation id="2307973900865360088">Kugcine Edokhini</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Enterprise Browser. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Enterprise Browser ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2332076562712130931">Lesi senzo sizokwenza lokhu:
          <ph name="LINE_BREAKS" />
           • Setha kabusha amanye wamasethingi eEnterprise Browser nezinqamuleli zeEnterprise Browser
           <ph name="LINE_BREAK" />
           • Khubaza izandiso
           <ph name="LINE_BREAK" />
           • Sula amakhukhi nenye idatha yesikhashana yesayithi
            <ph name="LINE_BREAKS" />
           Amabhukhimakhi, umlando, namaphasiwedi alondoloziwe ngeke aze athinteke.</translation>
<translation id="2343156876103232566">Ukuze uthumele inombolo kusukela lapha kufoni yakho ye-Android, ngena ngemvume ku-Enterprise Browser kuwo womabili amadivayisi.</translation>
<translation id="2356070529366658676">Buza</translation>
<translation id="2359808026110333948">Qhubeka</translation>
<translation id="2361918034042471035">Isandiso esithi "<ph name="EXTENSION_NAME" />" sifuna ukuthi ungene ngemvume kuEnterprise Browser</translation>
<translation id="236943522426971115">Vala iEnterprise Browser Esebenza Ngemuva kuma-App</translation>
<translation id="2374216753258219393">Ukuze usebenzise lesi sandiso njenge-<ph name="USER_EMAIL_ADDRESS" />, ngena ngemvume kuEnterprise Browser.</translation>
<translation id="2384373936468275798">I-ChromiumOS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-HID ibifinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}=1{Idivayisi e-1 ye-HID ifinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}one{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}other{Amadivayisi angu-# e-HID abefinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}}</translation>
<translation id="2401032172288869980">I-Enterprise Browser idinga izimvume zekhamera nemakrofoni kule sayithi</translation>
<translation id="2403703063067034158">Iphutha lokuqala: esinye isenzakalo sokusetha siyaqalisa okwamanje, sicela uzame futhi ngokuhamba kwesikhathi.</translation>
<translation id="2440750600860946460"><ph name="BEGIN_LINK" />Ngamathuluzi avela ku-Enterprise Browser<ph name="END_LINK" />, ungabhrawuza ngokuphepha bese uhlala ulawula</translation>
<translation id="2451727308784734061">Sebenzisa isinqamuleli sakho ukuze ufike ngokushesha Kusiphathi Sephasiwedi. Ungahambisa isinqamuleli sakho esikrinini sasekhaya sekhompyutha yakho noma isiqalisi se-app.</translation>
<translation id="2478295928299953161">I-Enterprise Browser izovala maduzane</translation>
<translation id="2483889755041906834">Ku-Enterprise Browser</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2513154137948333830">Ukuqalisa kuyadingeka: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Khetha umbhalo Ngosesho Lomfanekiso</translation>
<translation id="2554739539410784893">I-Enterprise Browser izama ukufaka amaphasiwedi akhona esikhundleni. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="2560420686485554789">I-Enterprise Browser idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="2572494885440352020">Isisizi se-Enterprise Browser</translation>
<translation id="2575822587468774919">Khetha noma yini ukuze useshe Ngosesho Lomfanekiso</translation>
<translation id="2576118232315942160">Ukuze uthole amaphasiwedi akho kanye nokwengeziwe kuwo wonke amadivayisi akho, ngena ngemvume kuEnterprise Browser</translation>
<translation id="2592940277904433508">Qhubeka usebenzisa i-Enterprise Browser</translation>
<translation id="259935314519650377">Yehlulekile ukufaka enqolobaneni isifaki esidawunilodiwe. Iphutha: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Isistimu</translation>
<translation id="2629740064077610681">Inhlangano yakho ingabona futhi ilawule idatha yopheqululo, efana namabhukhimakhi akho, umlando, namaphasiwedi. Ayikwazi ukubona idatha yokubhrawuza kwamanye amaphrofayela eEnterprise Browser</translation>
<translation id="2635452620547538388">Qinisekisa ukuthi nguwe ukuze usebenzise futhi ulondoloze idatha yeEnterprise Browser ku-akhawunti yakho, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2637732208198500597">{COUNT,plural, =0{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iEnterprise Browser ukuze usebenzise isibuyekezo}=1{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iEnterprise Browser ukuze usebenzise isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iEnterprise Browser ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Ukuvikelwa Okuthuthukile kudinga ukuthi uqalise kabusha iEnterprise Browser ukuze usebenzise isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="2648074677641340862">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-Enterprise Browser.</translation>
<translation id="2661879430930417727">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-Enterprise Browser ngendlela abafuna ngayo</translation>
<translation id="2711502716910134313">Ithebhu le-Enterprise Browser</translation>
<translation id="2718390899429598676">Ngokuvikela okungeziwe, i-Enterprise Browser izobethela idatha yakho.</translation>
<translation id="2721354645805494590">Ukuze ususe i-Google Account yakho ku-Enterprise Browser, phuma ngemvume</translation>
<translation id="2722636413143664436">Ukuze uthole amaphasiwedi wakho, amabhukhimakhi, nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuEnterprise Browser</translation>
<translation id="2738871930057338499">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 403 Yenqatshelwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="2753623023919742414">Chofoza ukuze useshe</translation>
<translation id="2768103863314748511">Setha iEnterprise Browser njengesibuki sakho esizenzakalelayo se-PDF</translation>
<translation id="2785438272836277133">Lesi sandiso sinohlelo olungayilungele ikhompyutha futhi asiphephile. Sisuse ku-Enterprise Browser ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="2803971713792056305">IEnterprise Browser Yakho</translation>
<translation id="2816462166102338036">Sesha le vidiyo ngesakhi esithi Ukusesha Ngezithombe</translation>
<translation id="2841525013647267359">Humusha kusuka</translation>
<translation id="2846251086934905009">Iphutha lokufaka: Isifaki asiqedanga. Ukufakwa kukhanseliwe.</translation>
<translation id="2847479871509788944">Susa kusuka  ku-Enterprise Browser...</translation>
<translation id="2850691299438350830">Kukugcina uphephile ku-Enterprise Browser futhi kungase kusetshenziswe ukuthuthukisa ukuvikeleka kwakho kwamanye ama-app we-Google lapho ungene ngemvume</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="2910007522516064972">Mayelana ne-&amp;Enterprise Browser</translation>
<translation id="2915996080311180594">Qala Kabusha Ngemuva Kwesikhathi</translation>
<translation id="2928420929544864228">Ukufaka kuqedile.</translation>
<translation id="2933336679234709858">Idatha yakho ibethelwe ngomushwana wakho wokungena. Ifake ukuze usebenzise futhi wonge idatha yeEnterprise Browser kuGoogle Account yakho.</translation>
<translation id="2945997411976714835">Iphutha lokufaka: Inqubo yesifaki yehlulekile ukuqala.</translation>
<translation id="2948852018303413228">Ngena ngemvume ngokushesha kumasayithi usebenzisa amaphasiwedi alondoloziwe weEnterprise Browser ku-iOS</translation>
<translation id="2966959524256557996">Engeza iphrofayela entsha yeEnterprise Browser ukuze uhlukanise amabhukhimakhi, amaphasiwedi, namasethingi.</translation>
<translation id="2970426615109535079">Inhlangano yakho iphatha iEnterprise Browser</translation>
<translation id="2977470724722393594">I-Enterprise Browser isesikhathini samanje</translation>
<translation id="2977506796191543575">Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Enterprise Browser ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile</translation>
<translation id="2981563588585023386">Ukuze uhlale uphephile ku-inthanethi ngokukhethwayo komzali wakho, ngena ngemvume kuEnterprise Browser</translation>
<translation id="3003694935412297923">Yonke imisebenzi</translation>
<translation id="3012615494352020668">{count,plural, =1{IEnterprise Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (into e-1) izosulwa.}one{IEnterprise Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}other{IEnterprise Browser idinga ukuqinisekisa ukuthi uwena ngaphambi kokuthi idatha ethile ilondolozwe kuGoogle Account yakho futhi isetshenziswe kuwo wonke amadivayisi akho. Uma uphuma ngemvume manje, le datha (izinto ezingu-{count}) izosulwa.}}</translation>
<translation id="3013473503895162900">Vula i-<ph name="URL" /> kuthebhu entsha ku-Enterprise Browser.</translation>
<translation id="3032706164202344641">I-Enterprise Browser ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emuva kwesikhathi.</translation>
<translation id="3032787606318309379">Ingeza ku-Enterprise Browser...</translation>
<translation id="3038232873781883849">Ilinde ukufaka...</translation>
<translation id="3045032126857188731">Ulimi oluhunyushiwe: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Vala idayalogi yempendulo</translation>
<translation id="3068187312562070417">Amanye amaphrofayela e-Enterprise Browser</translation>
<translation id="3068515742935458733">Siza ukwenza i-Enterprise Browser ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-Google</translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Idivayisi e-1 ye-USB ibifinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}=1{Idivayisi e-1 ye-USB ifinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}one{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}other{Amadivayisi angu-# e-USB abefinyelelwa yisandiso se-Enterprise Browser esisodwa noma eziningi}}</translation>
<translation id="3095811995836568724">Umlando weEnterprise Browser</translation>
<translation id="3103660991484857065">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-Enterprise Browser futhi.</translation>
<translation id="310459126943037700">Yehlulekile ukuqeda imisebenzi.</translation>
<translation id="3130323860337406239">I-Enterprise Browser isebenzisa imakrofoni yakho.</translation>
<translation id="3130333203120345554">Usesho olusha</translation>
<translation id="3137969841538672700">Hudulela oseshweni</translation>
<translation id="3144188012276422546">Le thebhu isebenzisa izinsiza ezengeziwe. Ukuze uthuthukise ukusebenza kwakho, vumela iEnterprise Browser ikwenze kungasebenzi.</translation>
<translation id="3149163023759831301">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweEnterprise Browser Kumasethingi Ohlelo</translation>
<translation id="3155163173539279776">Phinda uqalise i-Enterprise Browser</translation>
<translation id="3161522574479303604">Zonke izilimi</translation>
<translation id="3179665906251668410">Vula isixhumanisi kuwindi le-Enterprise Browser Inco&amp;gnito</translation>
<translation id="3183357154200327217">Olunye uhlelo kukhompyutha yakho lwengeze itimu engaguqula indlela iEnterprise Browser esebenza ngayo.

<ph name="EXTENSION_NAME" /></translation>
<translation id="3185330573522821672">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-Enterprise Browser</translation>
<translation id="3224847870593914902">Ukuze ususe i-Google Account yakho ku-Enterprise Browser, phuma ngemvume ku-Enterprise Browser ekhasini Lamasethingi</translation>
<translation id="3234316605225071811">Emva kwesikhathi, iEnterprise Browser ingakucela ukuthi usebenzise ulwazi olulondoloziwe ukuze uzigcwalisele amafomu</translation>
<translation id="3258596308407688501">I-Enterprise Browser ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3286538390144397061">Qala kabusha manje</translation>
<translation id="328888136576916638">Okhiye be-Google API abekho. Okunye ukusebenza kwe-Enterprise Browser kuzokhutshazwa.</translation>
<translation id="3296368748942286671">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-Enterprise Browser ivaliwe</translation>
<translation id="3313189106987092621">I-Enterprise Browser izokuxwayisa ngaphambi kokulayisha noma iyiphi isayithi isebenzisa uxhumo olungavikelekile</translation>
<translation id="3316771292331273802">Uzophuma ngemvume emasayithini amaningi uma uvala wonke amawindi e-Enterprise Browser, ngaphandle kwe-Google Account yakho uma ungene ngemvume ku-Enterprise Browser. Ukuvumela amasayithi akukhumbule, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3322413454779348750">Injini yakho yokusesha ezenzakalelayo ishintshwe ngaphandle kweEnterprise Browser. Ukuze ikuvikele, iEnterprise Browser iyisethe kabusha.</translation>
<translation id="3352986031709923790">ikhona elingaphezulu ngakwesokudla lendawo yokusesha: ngakwesokudla okungu-<ph name="RIGHT" />%, phezulu okungu-<ph name="TOP" />%</translation>
<translation id="3366305173356742781">Idatha ye-Enterprise Browser ku-akhawunti yakho</translation>
<translation id="3369405342922656244">Sesha leli khasi ngesakhi esithi Ukusesha Ngezithombe</translation>
<translation id="3387527074123400161">I-ChromiumOS</translation>
<translation id="3406848076815591792">Shintshela kwiphrofayela le-Enterprise Browser elikhona kakade?</translation>
<translation id="3412460710772753638">Kokuthi Isiphathi Sephasiwedi kule divayisi</translation>
<translation id="3461644266919055473">Yenza iEnterprise Browser ibe ngeyakho...</translation>
<translation id="347328004046849135">I-Enterprise Browser izokwazisa uma ungena ngemvume ngephasiwedi eyonakalisiwe</translation>
<translation id="3474745554856756813">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL" /> njengo.</translation>
<translation id="3497319089134299931">I-<ph name="SHORTCUT" /> ingashintsha phakathi kwamaphrofayela we-Enterprise Browser</translation>
<translation id="3509308970982693815">Sicela uvale wonke amawindi we-Enterprise Browser uphinde uzame futhi.</translation>
<translation id="3522404737534491619">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweEnterprise Browser Kumasethingi Ohlelo.</translation>
<translation id="3530103706039034513">U-<ph name="EXISTING_USER" /> usevele ungene ngemvume.  Ukuze ugcine ukubhrawuza kwakho kuhlukile, ngena ngemvume ku-Enterprise Browser kuphrofayela yakho njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="3561853857681580870">Ukuze wabelane ngesikrini sakho, vumela ukurekhodwa kwesikrini kweEnterprise Browser Kumasethingi Ohlelo.</translation>
<translation id="3597003331831379823">Ihlulekile ukuqalisa isethaphu ngamalungelo aphakeme. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-Enterprise Browser njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Isibuyekezo esisha se-Enterprise Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-Enterprise Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-Enterprise Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-Enterprise Browser siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3651803019964686660">Ukuze uthumele inombolo kusukela ku-<ph name="ORIGIN" /> kufoni yakho ye-Android, ngena ngemvume ku-Enterprise Browser kuwo womabili amadivayisi.</translation>
<translation id="3667616615096815454">Ayikwazi ukufaka, uhlelo lokusebenza alwaziwa kuseva.</translation>
<translation id="3675854891107786059">Sebenzisa <ph name="BEGIN_LINK" />umushwana wokungena <ph name="END_LINK" />ukuze ubhale ngokubethela idatha yeEnterprise Browser kuGoogle Account yakho. Izindlela zokukhokha namakheli kusuka kuGoogle Pay ngeke kubethelwe. Umlando wokubhrawuza ovela kuEnterprise Browser ngeke uvumelanise.</translation>
<translation id="3685209450716071127">I-Enterprise Browser ayikwazi ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-Enterprise Browser ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3713809861844741608">Vula isixhumanisi ku&amp;thebhu elisha le-Enterprise Browser</translation>
<translation id="3728124580182886854">Linka i-Enterprise Browser namanye amasevisi e-Google ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="3729187154190517324">Julisa usesho lwakho ngokufaka amathebhu amaningi, amafayela, namathuluzi usebenzisa inkinobho ethi "Faka ithebhu nokuningi".</translation>
<translation id="3788675262216168505">Phatha Amaphrofayela e-Enterprise Browser</translation>
<translation id="3790262771324122253">Funda ukuthi kungani i-Enterprise Browser ivimbela ukudawuniloda okuthile</translation>
<translation id="379589255253486813">I-Enterprise Browser izokwazisa uma kukhona okudinga isibuyekezo sakho</translation>
<translation id="3798048725356732506">Amaphrofayela eEnterprise Browser akusiza uhlukanise izingxenye ezihlukene zokuphila kwakho. Engeza iphrofayela entsha manje.</translation>
<translation id="3802055581630249637">I-Enterprise Browser ilayisha kusengaphambili amakhasi okungenzeka uwavakashele, ukuze alayishe ngokushesha lapho uwavakashela</translation>
<translation id="3810973564298564668">Phatha</translation>
<translation id="3846683726093018685">**Fingqa:** Ngomusho owodwa onamagama angaphansi kwa-30, chaza abantu ebhekiswe kubo nenjongo eyinhloko yekhontenti yakho eku-screenshot.

          **Phakamisa Imibuzo:** Sungula uhlu lwamachashazi olunemibuzo emi-3 ukuya kwemi-5 eshukumisa ingqondo engase ibuzwe umsebenzisi ukuze asiqonde kahle i-screenshot. Le mibuzo kufanele ihlanganise okungenani owodwa okhuluma ngokuqondile ngento ebukwayo, indlela eklanywe ngayo, noma indawo ekuyo.</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Enterprise Browser</translation>
<translation id="3885770153807205175">Okokukhetha ulimi</translation>
<translation id="388648406173476553">Yenza ngokwezifiso uphinde ulawule i-Enterprise Browser. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="3889543394854987837">Chofoza igama lakho ukuze uvule i-Enterprise Browser uphinde uqale ukudlulisa amehlo.</translation>
<translation id="3892148308691398805">Kopisha umbhalo</translation>
<translation id="390528597099634151">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-Enterprise Browser. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-Enterprise Browser ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="3909353120217047026">Lesi sandiso sephula inqubomgomo Yesitolo sewebu se-Enterprise Browser, futhi kungenzeka singabi esiphephile. Sisuse ku-Enterprise Browser ukuze singasakwazi ukubona nokushintsha idatha yakho kumasayithi owavakashelayo, okufaka phakathi ulwazi lwakho lomuntu siqu.</translation>
<translation id="3937491663738985329">Qamba ngokwabahlinzekelwayo iEnterprise Browser Yakho</translation>
<translation id="3941890832296813527">Iphutha lokufaka: Igama lefayela lesifaki alivumelekile noma alisekelwe.</translation>
<translation id="3945058413678539331">I-Enterprise Browser izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="3954172517175569325">Amaphasiwedi akho, izindlela zokukhokha, namakheli owalondoloze kuGoogle Account yakho azosuswa kule divayisi. Ukuze uphinde uzisebenzise kuEnterprise Browser, ngena ngemvume futhi.</translation>
<translation id="395904275706073188">Amakhasi avikelwe awakwazi ukufundwa. Zama ikhasi elehlukile.</translation>
<translation id="3962647064319009959">Funda ukuthi i-Enterprise Browser ikugcina kanjani uphephile</translation>
<translation id="3971865010372729242">Uma uthayipha kubha yekheli noma ebhokisini lokusesha, iEnterprise Browser ithumela okuthayiphayo kusesho lwenhlangano yakho, i-AI, nakumathuluzi omenzeli ukuthola iziphakamiso.</translation>
<translation id="3975724895399328945">Mayelana ne-&amp;Enterprise Browser Yokuhlola</translation>
<translation id="3997429360543082038">Mayelana ne-ChromiumOS</translation>
<translation id="4019629340646866719">I-ChromiumOS yenziwe ukuthi isebenze ngesofthiwe yomthombo ovulekile owengeziwe<ph name="BEGIN_LINK_CROS_OSS" />isofthiwe yomthombo ovulekile<ph name="END_LINK_CROS_OSS" />, njengoba kunjalo ngendawo yokuthuthukiswa kwe-<ph name="BEGIN_LINK_LINUX_OSS" />Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="4022972681110646219">Isikrini sokuhumusha</translation>
<translation id="4023601594785368013">Ulimi loqobo: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Vula amalinki kuEnterprise Browser kunoma iyiphi i-app. Futhi ukuze ifinyeleleke kalula, iphinwa ku-taskbar yakho.</translation>
<translation id="4036079820698952681">Siza i-Enterprise Browser ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="4039097928859803404">Bonisa njalo izinqamuleli Zemodi ye-AI</translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="4055805654398742145">Umphathi Wephasiwedi</translation>
<translation id="4061696872429826774">Olunye uhlelo olukukhompyutha yakho lwengeze isandiso esingaguqula indlela iEnterprise Browser esebenza ngayo.

<ph name="EXTENSION_NAME" /></translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}one{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}other{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#. Idatha yokubhrawuza isuliwe. Lokhu kungase kuhlanganise umlando, ukugcwalisa ngokuzenzakalelayo, nokudawuniloda.}}</translation>
<translation id="4118474109249235144">I-Enterprise Browser Incognito</translation>
<translation id="4122186850977583290">Iya ekhasini elithi Mayelana neEnterprise Browser</translation>
<translation id="4147856324248078748">Qamba ngokwabahlinzekelwayo iEnterprise Browser yakho</translation>
<translation id="4148957013307229264">Iyafaka...</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-Enterprise Browser</translation>
<translation id="421369550622382712">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-Enterprise Browser.</translation>
<translation id="4217080900579554343">Ukuze uthole lesi sandiso nokuningi kuwo wonke amakhompyutha wakho, ngena ngemvume kuEnterprise Browser</translation>
<translation id="4217972271355023382">Ukuze uhlale uphephile ku-inthanethi ngokukhetha komzali wakho, shintshela kuphrofayela yakho yeEnterprise Browser lapho usungene ngemvume kakade njengo-<ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="4222932583846282852">Iyakhansela...</translation>
<translation id="4224210481850767180">Ukufaka kukhanseliwe.</translation>
<translation id="4230135487732243613">Xhumanisa idatha yakho ye-Enterprise Browser kule akhawunti?</translation>
<translation id="4251772536351901305">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Google ebingazi ngawo ngaphambili, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-Enterprise Browser.</translation>
<translation id="4269093074552541569">Phuma Ngemvume ku-Enterprise Browser</translation>
<translation id="4271805377592243930">Thola usizo nge-Enterprise Browser</translation>
<translation id="4281844954008187215">Imigomo yesevisi</translation>
<translation id="4285930937574705105">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-Enterprise Browser iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="4298125729853015961">Khipha amaphasiwedi Ukusuka kuEnterprise Browser</translation>
<translation id="4304713468139749426">Isiphathi sephasiwedi</translation>
<translation id="4334241893986177674">Sesha lesi sithombe-skrini</translation>
<translation id="4334294535648607276">Ukulanda kuqedile.</translation>
<translation id="439358628917130594">I-<ph name="MANAGER" /> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebi, iguqule noma ikhawulele Imigomo ye-ChromiumOS.</translation>
<translation id="4407044323746248786">Phuma ku-Enterprise Browser noma kunjalo?</translation>
<translation id="4413205837991854510">Bonisa Isinqamuleli Sokusesha Umfanekiso Njalo</translation>
<translation id="4415566066719264597">Vumela i-Enterprise Browser isebenze ngemuva</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{IEnterprise Browser incoma ukuthi usisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}one{IEnterprise Browser incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}other{IEnterprise Browser incoma ukuthi uzisuse. <ph name="BEGIN_LINK" />Funda kabanzi mayelana nezandiso ezisekelwayo<ph name="END_LINK" />}}</translation>
<translation id="4423735387467980091">Yenza ngokwezifiso uphinde ulawule i-Enterprise Browser</translation>
<translation id="4427306783828095590">Isivikelo esithuthukisiwe senza okuningi ukuvimba ubugebengu bokweba imininingwane ebucayi kanye uhlelo olungayilungele ikhompyutha</translation>
<translation id="4434353761996769206">Iphutha lesifaki: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">U-<ph name="MANAGER" /> uphatha iEnterprise Browser</translation>
<translation id="444069871276811466">Faka iphrofayela yeEnterprise Browser</translation>
<translation id="4447409407328223819">Mayelana ne-Enterprise Browser Yokuhlola</translation>
<translation id="4470974262661801543">Ukuze usebenzise futhi ulondoloze idatha yeEnterprise Browser kuGoogle Account yakho, faka umushwana wakho wokungena</translation>
<translation id="4493028449971051158">Iphutha ekuqaliseni: sicela usebenzise isifaki njengomlawuli.</translation>
<translation id="4501471624619070934">Ukufaka kuhlulekile ngoba ukufinyelela kukhawulelwe kuleli zwe.</translation>
<translation id="4510853178268397146">Lesi sandiso asikashicileli izindlela zangasese zokuziphatha, njengokuthi siyiqoqa futhi siyisebenzise kanjani idatha. I-Enterprise Browser incoma ukuthi usisuse.</translation>
<translation id="452711251841752011">Siyakwamukela ku-Enterprise Browser; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="4531137820806573936">I-Enterprise Browser idinga imvume yokumepha indawo ekuzungezile futhi ilandelele izandla zakho</translation>
<translation id="4534145890176164066">IEnterprise Browser iwaqonda kangcono amafomu futhi ingakugcwalisela wona ngokuzenzekelayo ngokushesha</translation>
<translation id="4536805923587466102">Usuvele ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" /> kwenye iphrofayela ye-Enterprise Browser</translation>
<translation id="4548534452171747496">IEnterprise Browser ilayisha ngaphambilini amakhasi okwenza ukubhrawuza nokusesha kusheshe. <ph name="BEGIN_LINK" />Funda kabanzi mayelana namakhasi okulayisha kuqala<ph name="END_LINK" /></translation>
<translation id="4567424176335768812">Ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" />. Manje ungakwazi ukufinyelela amabhukhimakhi, umlando, nezinye izilungiselelo kuwo wonke amadivayisi wakho ongene kuwo ngemvume.</translation>
<translation id="4570813286784708942">I-Enterprise Browser ivimbele lokhu kudawuniloda ngoba uvale Ukuphequlula Okuphephile futhi ifayela alikwazi ukuqinisekiswa</translation>
<translation id="4594305310729380060">Kusiphathi Sephasiwedi kule divayisi</translation>
<translation id="459535195905078186">Izinhlelo zokusebenza ze-Enterprise Browser</translation>
<translation id="4598116752460667024">Sesha noma iyiphi inqubo ohlwini.</translation>
<translation id="4613863813562375431">Uhlobo lwe-ChromiumOS</translation>
<translation id="4621240073146040695">Icishe isesikhathini! Qalisa kabusha i-Enterprise Browser ukuze uqedele ukubuyekeza.</translation>
<translation id="4625064703209785397">Isheshisa amasayithi anenjini yeEnterprise Browser V8 kodwa yenza iEnterprise Browser ingabi namandla okumelana nokuhlaselwa.</translation>
<translation id="4654936675281451226">IEnterprise Browser iwaqonda kangcono amafomu futhi ingakugcwalisela wona ngokuzenzekelayo ngokushesha. Leli sethingi livuliwe.</translation>
<translation id="4665829708273112819">Isexwayiso: I-Enterprise Browser ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4673151026126227699">Uma futhi wabelana ngemibiko yokusetshenziswa kwe-Enterprise Browser, leyo mibiko ihlanganisa nama-URL owavakashelayo</translation>
<translation id="4677944499843243528">Iphrofayela ibukeka isetshenziswa enye inqubo ye-Enterprise Browser (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-Enterprise Browser ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-Enterprise Browser.</translation>
<translation id="4680828127924988555">Khansela Ukufaka</translation>
<translation id="469259825538636168">Enye idatha yakho yeEnterprise Browser ayikalondolozwa kuGoogle Account. Zama ukulinda imizuzu embalwa ngaphambi kokuphuma ngemvume. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="4708193446201257833">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ukusuka kuGoogle Account yakho kuEnterprise Browser. I-<ph name="SHORTCUT" /> ingashintsha amasethingi wakho wamasevisi eGoogle.</translation>
<translation id="4708774505295300557">Umuntu othile ungene ngemvume ngaphambilini ku-Enterprise Browser kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-Enterprise Browser ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4724676981607797757">Ukufaka kuhlulekile ngenxa yephutha lephrothokholi engasekelwe.</translation>
<translation id="4746050847053251315">Phuma ku-Enterprise Browser noma kunjalo?</translation>
<translation id="4748217263233248895">Isibuyekezo esibalulekile sokuvikela se-Enterprise Browser sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4759645701210484457">Buza iEnterprise Browser</translation>
<translation id="4771701986670315895">Awukavakashi kamuva nje. IEnterprise Browser isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, nokunye okungu-<ph name="COUNT" /> okwengeziwe</translation>
<translation id="4788777615168560705">I-Enterprise Browser ayikwazi ukuhlola iphasiwedi yakho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK" />hlola amaphasiwedi ku-akhawunti yakho ye-Google<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-Google. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-Google. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="4814736265800133385">Sebenzisa i-Enterprise Browser ngaphandle kwe-akhawunti</translation>
<translation id="4888717733111232871">Umyalo obambeke ngaphakathi we-Enterprise Browser wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="4893347770495441059">Qalisa kabusha ukuze Ubuyekeze i-&amp;Enterprise Browser</translation>
<translation id="4918844574251943176">Umfanekiso ukopishiwe</translation>
<translation id="4943838377383847465">I-Enterprise Browser kumodi yasemuva.</translation>
<translation id="494490797786467921">Chofoza ukuze uvale ibhokisi lokungena ngemvume leEnterprise Browser</translation>
<translation id="4950660488495335294">Ngamaphrofayela weEnterprise Browser ungahlukanisa zonke izinto zakho zeEnterprise Browser. Sungula amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="4987820182225656817">Izihambeli zingasebenzisa i-Enterprise Browser ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="4992938037305302429">I-akhawunti Yakho kuEnterprise Browser</translation>
<translation id="4994636714258228724">Zingeze ngokwakho ku-Enterprise Browser</translation>
<translation id="5123973130450702873">IEnterprise Browser idinga imvume ukuze ilandelele izandla zakho</translation>
<translation id="5141988424377517949">Awukavakashi kamuva nje. IEnterprise Browser isuse i-<ph name="PERMISSION_1" />, i-<ph name="PERMISSION_2" />, i-<ph name="PERMISSION_3" />.</translation>
<translation id="5167819546851111585">Yini oyicabangayo namuhla?</translation>
<translation id="5174969993834422967">Uvamise ukuvimba izaziso. Ukuze uvumele leli sayithi ukuthi likwazise, chofoza isithonjana sesaziso ekhoneni elingakwesokudla lebha yendawo yakho.</translation>
<translation id="5174983315706567306">Asikho isikhala sediski esanele.</translation>
<translation id="5187123684706427865">I-akhawunti yeEnterprise Browser idinga ukuqinisekiswa kabusha</translation>
<translation id="5224391634244552924">Awekho amaphasiwedi alondoloziwe. I-Enterprise Browser ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="5231355151045086930">Phuma ngemvume ku-Enterprise Browser</translation>
<translation id="5234764350956374838">Cashisa</translation>
<translation id="5254739261293693943">Buza ngale vidiyo</translation>
<translation id="5277894862589591112">Ukuze ufake izinguquko zakho, qalisa kabusha i-Enterprise Browser</translation>
<translation id="5286907366254680517">Okutholiwe</translation>
<translation id="5294316920224716406">Uma ubhrawuza ngemodi ye-Incognito, i-Enterprise Browser izokuxwayisa ngaphambi kokulayisha isayithi isebenzisa uxhumo olungavikelekile.</translation>
<translation id="5313228254328109263">Isevisi Yangaphakathi Yesibuyekezi SeEnterprise Browser</translation>
<translation id="5346389065299425353">Julisa usesho lwakho ngokufaka amathebhu amaningi, amafayela, namathuluzi</translation>
<translation id="5352264705793813212">I-Enterprise Browser ithole izincomo ezithile zokuphepha zokubuyekeza kwakho</translation>
<translation id="5352361688875342522">Amanye Amaphrofayela e-Enterprise Browser</translation>
<translation id="5358375970380395591">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-Enterprise Browser. Idatha yakho ye-Enterprise Browser, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Ikhodi eyengeziwe: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Ukuze uthole ukwenza ngokomuntu ngamunye, okufaka i-Enterprise Browser Kumsebenzi Wewebhu nowe-App</translation>
<translation id="5383439451358640070">Funda ukuthi kungani i-Enterprise Browser ivimba amanye amafayela</translation>
<translation id="5386450000063123300">Ibuyekeza i-Enterprise Browser (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Vumela ukungena ngemvume kwe-Enterprise Browser</translation>
<translation id="5405650547142096840">Susa kusuka  ku-Enterprise Browser</translation>
<translation id="5424544524441439284">Yehlisa indlela yokusebenza kodwa kwenza iEnterprise Browser imelane nakakhulu nokuhlaselwa</translation>
<translation id="5427571867875391349">Setha i-Enterprise Browser njengesiphequluli sakho esizenzakalelayo</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Enterprise Browser Beta</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{IEnterprise Browser Incoma Ukumisa Ithebhu Enciphisa Ijubane Lebhrawuza Yakho}one{IEnterprise Browser Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}other{IEnterprise Browser Incoma Ukumisa Amathebhu Anciphisa Ijubane Lebhrawuza Yakho}}</translation>
<translation id="5473971139929175403">I-Enterprise Browser kungenzeka ingasebenzi ngokufanelekile ngoba ayisasekelwa kule sistimu yokusatshalaliswa kwe-Linux</translation>
<translation id="5475924890392386523">I-Enterprise Browser ivimbele lokhu kudawuniloda ngoba ifayela lingalimaza ama-akhawunti wakho omuntu siqu nawenethiwekhi yokuxhumana nomphakathi</translation>
<translation id="5480860683791598150">I-Enterprise Browser idinga ukufinyelela kundawo yakho ukuze yabelane ngendawo yakho naleli sayithi</translation>
<translation id="549669000822060376">Sicela ulinde ngenkathi i-Enterprise Browser ifaka izibuyekezo zesistimu zakamuva.</translation>
<translation id="5496810170689441661">I-Enterprise Browser izama ukuhlela amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="5524890928877629608">ikhona elingaphezulu ngakwesokunxele lendawo yokusesha: ngakwesokunxele okungu-<ph name="LEFT" />%, phezulu okungu<ph name="TOP" />%</translation>
<translation id="5527463683072221100">Vula ama-PDF ku-Enterprise Browser</translation>
<translation id="5536164441519929134">Buza<ph name="LINE_BREAK" />mayelana nale thebhu</translation>
<translation id="5579324208890605088">Iphutha ekuqaliseni: sicela usebenzise isifaki njengomsebenzisi ovamile, hhayi njengomlawuli.</translation>
<translation id="5580770360767802657">Sebenzisa iEnterprise Browser ngokuzenzakalelayo futhi uyenze iphinwe</translation>
<translation id="5596627076506792578">Izinketho eziningi</translation>
<translation id="5605834417512968703">Khetha noma yini ukuze useshe Ngosesho Lomfanekiso noma ucindezele u-escape ukuze uphume Kusesho Lomfanekiso</translation>
<translation id="5618818588972826921">Khetha noma yimuphi umbhalo noma isithombe ukuze useshe Ngosesho Lwezithombe noma cindezela u-escape ukuze uphume Oseshweni Lwezithombe</translation>
<translation id="5623402015214259806">{0,plural, =0{Isibuyekezo se-Enterprise Browser siyatholakala}=1{Isibuyekezo se-Enterprise Browser siyatholakala}one{Isibuyekezo se-Enterprise Browser sitholakala ngezinsuku ezingu-#}other{Isibuyekezo se-Enterprise Browser sitholakala ngezinsuku ezingu-#}}</translation>
<translation id="5633450273457573375">Sebenzisa <ph name="BEGIN_LINK" />umushwana wokungena <ph name="END_LINK" />ukuze ubhale ngokubethela idatha yeEnterprise Browser kuGoogle Account yakho. Amakheli nanoma iyiphi idatha elondolozwe kuGoogle Wallet ngeke ibethelwe ngomushwana wakho wokungena. Umlando wokubhrawuza ovela kuEnterprise Browser ngeke uvumelanise.</translation>
<translation id="5643865575100044307">Yisule njalo idatha yesayithi kudivayisi yakho lapho uvala i-Enterprise Browser</translation>
<translation id="5653831366781983928">Sicela uqalise kabusha i-Enterprise Browser manje</translation>
<translation id="5690427481109656848">I-Google LLC</translation>
<translation id="5698481217667032250">Veza i-Enterprise Browser ngalolu limi</translation>
<translation id="569897634095159764">Ayikwazi ukuxhuma ku-inthanethi Iseva elibamba idinga ukufakazela ubuqiniso.</translation>
<translation id="5713518899297503106">Amaphrofayela eEnterprise Browser akuvumela ukuba uhlukanise ukubhrawuza kwakho siqu nomsebenzi. Engeza iphrofayela entsha manje.</translation>
<translation id="5768371961535086509">IEnterprise Browser ikhulula inkumbulo kumathebhu angasebenzi. Lokhu kunikeza amathebhu asebenzayo namanye ama-app izinsiza zekhompyutha ezengeziwe futhi kugcina iEnterprise Browser ishesha. Amathebhu akho angasebenzi aphinde asebenze ngokuzenzekela uma ubuyela kuwo. <ph name="BEGIN_LINK" />Funda kabanzi mayelana Nesilondolozi Senkumbulo<ph name="END_LINK" /></translation>
<translation id="5775198138441669627">Uma ukhohlwa umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="SETTINGS_LINK" /> idatha yeEnterprise Browser ku-akhawunti yakho</translation>
<translation id="5800158606660203929">Yenza ngokwezifiso uphinde ulawule i-Enterprise Browser. Setha i-Enterprise Browser njengokwakho okuzenzakalelayo.</translation>
<translation id="5809516625706423866">Ayikwazi ukuxhuma ku-inthanethi I-HTTP 401 Ayigunyaziwe. Sicela uchekhe ukulungiselelwa kommeleli wakho.</translation>
<translation id="5817952762723416573">Isheshisa amasayithi ngenjini yeEnterprise Browser V8 kodwa yenza iEnterprise Browser imelane kancane nokuhlaselwa. Le sethingi livaliwe.</translation>
<translation id="5821520528363214608">Ukuze usebenzise futhi ulondoloze idatha yeEnterprise Browser kuGoogle Account yakho, buyekeza iEnterprise Browser</translation>
<translation id="5824893331272123205">Ayikwazanga ukulayisha leli phaneli, zama futhi</translation>
<translation id="5862307444128926510">Siyakwamukela ku-Enterprise Browser</translation>
<translation id="5871205389137001634">Chofoza ukuze uphume Kusesho Lomfanekiso</translation>
<translation id="5883558403894052917">I-Enterprise Browser ithole ukuthi lezi zinto zinohlelo olungayilungele ikhompyutha</translation>
<translation id="5889361821821684993">I-Enterprise Browser ihlale ihlola ukuze iqinisekise ukuthi ibhrawuza inamasethingi aphephe kakhulu. Sizokwazisa uma kukhona okudinga ukubuyekezwa.</translation>
<translation id="5895138241574237353">Qalisa kabusha</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokugena ngemvume</translation>
<translation id="5924017743176219022">Ixhuma Ku-inthanethi...</translation>
<translation id="5941711191222866238">Nciphisa</translation>
<translation id="5949225980829865667">Ukuze uthole le bhukhimakhi nokuningi kuwo wonke amadivayisi akho, ngena ngemvume kuEnterprise Browser</translation>
<translation id="5953657885167112863">Yenza iEnterprise Browser Yakho</translation>
<translation id="5960071705175224773">Amasethingi akho ashintshwe yi-app engaziwa</translation>
<translation id="5968400720580217226">Imodi ye-AI</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga umzuzu o-1.}one{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}other{Inhlangano yakho ivala i-Enterprise Browser ngokuzenzekelayo uma ingasetshenziswanga imizuzu engu-#.}}</translation>
<translation id="5987687638152509985">Buyekeza i-Enterprise Browser ukuze uqale ukuvumelanisa</translation>
<translation id="6003112304606738118">Iyadawuniloda... Kusele amahora angu-<ph name="HOURS" /></translation>
<translation id="6009821354356307391">Cela ukulandelela</translation>
<translation id="6040143037577758943">Vala</translation>
<translation id="6058380562449900225">Ukuvikela idatha lakho vumela i-Enterprise Browser isuse izimvume kumasayithi ongakawavakasheli muva nje. Ayizimisi izaziso.</translation>
<translation id="6063093106622310249">&amp;Vula ku-Enterprise Browser</translation>
