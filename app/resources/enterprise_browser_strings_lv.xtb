<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1026101648481255140">Atsākt instalēšanu</translation>
<translation id="1029669172902658969">Atkārtoti palaist, lai atjauninātu &amp;Enterprise Browser OS</translation>
<translation id="103359417695385097">Enterprise Browser labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt. Šis iestatījums ir izslēgts.</translation>
<translation id="1040916596585577953">Enterprise Browser komanda iesaka pārskatīt šo paplašinājumu.</translation>
<translation id="1042552502243217427">Kad vietnē tiek piedāvāts privāti iepriekš ielādēt saites lapā, pārlūks Enterprise Browser izmanto Google serverus. Tādējādi jūsu identitāte tiek slēpta no iepriekš ielādētās lapas īpašniekiem, taču Google uzzina, kādas lapas tiek iepriekš ielādētas.</translation>
<translation id="1051793555070215510">Palīdziet mums uzlabot pārlūkošanu inkognito režīmā, aizpildot šo vienas minūtes aptauju.</translation>
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="1083934481477628225">Viens no jūsu vecākiem ir izslēdzis iestatījumu “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Enterprise Browser.</translation>
<translation id="1104942323762546749">Pārlūkā Enterprise Browser tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="112640046208448578">Varat identificēt priekšmetus vai vietas un kopēt vai tulkot tekstu. Kad izmantojat funkciju Attēlu meklēšana, uz serveri tiek nosūtīts lapas ekrānuzņēmums. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Jūsu noklusējuma pārlūks ir Enterprise Browser.</translation>
<translation id="1131805035311359397">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Noklikšķiniet uz Enterprise Browser izvēlnes</translation>
<translation id="1157985233335035034">Nesen izmantotās valodas</translation>
<translation id="1171831736360285680"><ph name="PARTNER_NAME" /> pievienoja paplašinājumu, kas var ietekmēt pārlūka Enterprise Browser darbību.

<ph name="EXTENSION_NAME" /></translation>
<translation id="1184145431117212167">Instalēšana neizdevās, jo jūsu izmantotā Windows versija netiek atbalstīta.</translation>
<translation id="1185134272377778587">Par Enterprise Browser</translation>
<translation id="1203500561924088507">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē pārlūkprogramma.</translation>
<translation id="123265588161106468">Kamēr esat pierakstījies, pārlūkā Enterprise Browser varat izmantot savas paroles un citu saturu no Google konta. Lai to mainītu, pārejiet uz sadaļu “Jūsu konts pārlūkā Enterprise Browser”.</translation>
<translation id="1262876892872089030">Kamēr šī cilne bija neaktīva, tika atbrīvota atmiņa pārlūka Enterprise Browser ātrākai darbībai. Varat izvēlēties vienmēr saglabāt šo vietni aktīvu.</translation>
<translation id="1265577313130862557">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo fails ir bīstams.</translation>
<translation id="126567311906253476">Ja pierakstāties Google pakalpojumos, piemēram, Gmail vai YouTube, ar kontu <ph name="USER_EMAIL" />, varat automātiski pierakstīties pārlūkā Enterprise Browser ar to pašu kontu.</translation>
<translation id="1290883685122687410">Iestatīšanas kļūda: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Jaunā Enterprise Browser profila iestatīšana</translation>
<translation id="1324107359134968521">Pārlūkam Enterprise Browser ir nepieciešama Bluetooth piekļuve, lai atrastu Bluetooth ierīces. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">Valodas noteikšana</translation>
<translation id="1342274909142618978">Dzēst arī datus no pārlūka Enterprise Browser (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana, izmantojot jauno pogu rīkjoslā.</translation>
<translation id="1356661055722410047">Jaunums! Varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="1383876407941801731">Meklēt</translation>
<translation id="1397530502368084401">&amp;Pārvaldīt Enterprise Browser profilus</translation>
<translation id="1414495520565016063">Esat pierakstījies operētājsistēmā Enterprise Browser!</translation>
<translation id="141901961143729572">Dalieties domās!</translation>
<translation id="1465192221147974788">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Enterprise Browser.</translation>
<translation id="1478370723027452770">Saņemt palīdzību saistībā ar Enterprise Browser for Testing</translation>
<translation id="1496875977627931224">Labdien, <ph name="USER_NAME" />!<ph name="LINE_BREAK" />Kas jums šodien padomā?</translation>
<translation id="1497802159252041924">Instalēšanas kļūda: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Šī lapa ir aizsargāta</translation>
<translation id="1524282610922162960">Enterprise Browser cilnes kopīgošana</translation>
<translation id="1547469039832541117">Tiek pabeigts atzīmētais uzdevums.</translation>
<translation id="1553461853655228091">Pārlūkam Enterprise Browser ir nepieciešama atļauja piekļūt jūsu kamerai, lai varētu izveidot jūsu apkārtnes 3D karti</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Šis paplašinājums vairs netiek atbalstīts. Enterprise Browser iesaka to noņemt.}zero{Šie paplašinājumi vairs netiek atbalstīti. Enterprise Browser iesaka tos noņemt.}one{Šie paplašinājumi vairs netiek atbalstīti. Enterprise Browser iesaka tos noņemt.}other{Šie paplašinājumi vairs netiek atbalstīti. Enterprise Browser iesaka tos noņemt.}}</translation>
<translation id="1562320819937089394">Piespraust pārlūku Enterprise Browser</translation>
<translation id="1574377791422810894">Enterprise Browser drošības rīki</translation>
<translation id="1594928384848033697">Enterprise Browser pieprasa dzēst jūsu paroļu pārvaldnieka datus. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Enterprise Browser.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Enterprise Browser. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="1625909126243026060">Pārskatiet svarīgākās konfidencialitātes un drošības vadīklas pārlūkā Enterprise Browser.</translation>
<translation id="1640672724030957280">Notiek lejupielāde...</translation>
<translation id="1680687534629375545">Jautāt attēlu meklēšanas funkcijai par šo lapu</translation>
<translation id="1709772298389099340">Nodrošina augstas privilēģijas pārlūkam <ph name="BROWSER_NAME" />.</translation>
<translation id="1715127912119967311">Lai palīdzētu uzlabot šīs funkcijas, pārlūks Enterprise Browser nosūta Google serveriem datus par jūsu mijiedarbību ar tām. Šos datus var lasīt, apstrādāt un anotēt pārskatītāji.</translation>
<translation id="1722488837206509557">Tādējādi varēsiet atlasīt kādu no pieejamām ierīcēm un parādīt tajā saturu.</translation>
<translation id="1733725117201708356">Pārlūkā Enterprise Browser drīz tiks dzēsti pārlūkošanas dati</translation>
<translation id="1736443181683099871">Pārlūkā Enterprise Browser tiks mēģināts navigācijai izmantot HTTPS.</translation>
<translation id="1736662517232558588">Enterprise Browser dati dzēsti</translation>
<translation id="1745121272106313518">Pārlūks Enterprise Browser tiks restartēts pēc: <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Ja HTTPS nav pieejams, pārlūkā Enterprise Browser bez brīdinājuma tiks izmantots nedrošs savienojums.</translation>
<translation id="1774152462503052664">Ļaut Enterprise Browser darboties fonā</translation>
<translation id="1779356040007214683">Lai uzlabotu Enterprise Browser drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="1808667845054772817">Pārinstalēt Enterprise Browser</translation>
<translation id="1820835682567584003">Enterprise Browser mēģina <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Kad nākamreiz savā ierīcē (<ph name="DEVICE_TYPE" />) atvērsiet pārlūku Enterprise Browser, tiks parādīts aicinājums izmantot Google paroļu pārvaldnieku.</translation>
<translation id="1838374766361614909">Notīrīt meklēšanas vaicājumu</translation>
<translation id="18552579716432081">Lai dzēstu pārlūkošanas datus tikai no šīs ierīces un paturētu tos Google kontā, <ph name="BEGIN_LINK" />izrakstieties no Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="185970820835152459">Varat pārvaldīt Google kontus, kuros esat pierakstījies. Jūsu Google konti tiek izmantoti pārlūkā Enterprise Browser, Play veikalā, pakalpojumā Gmail un citur. Ja vēlaties pievienot kontu kādam citam, piemēram, ģimenes loceklim, pievienojiet jaunu personu savai <ph name="DEVICE_TYPE" /> ierīcei. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="1862852878885210965">Meklēšana, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="1880677175115548835">Atlasīt tekstu</translation>
<translation id="1881322772814446296">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Enterprise Browser dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Enterprise Browser datus. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Pārlūkā Enterprise Browser tiek taupīta akumulatora enerģija, ierobežojot darbības fonā un vizuālos efektus, piemēram, vienmērīgu ritināšanu un video kadru nomaiņas ātrumu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par enerģijas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="1898804291554630487">Jautājiet par šo lapu</translation>
<translation id="1900969832270057921">Enterprise Browser atjauninātāja pakalpojums</translation>
<translation id="1911763535808217981">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Google vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Enterprise Browser.</translation>
<translation id="1929939181775079593">Enterprise Browser nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="1933341829955786215">Saskaņā ar jūsu organizācijas (<ph name="MANAGER" />) politiku jums ir jāpierakstās pārlūkā Enterprise Browser.</translation>
<translation id="193439633299369377">Enterprise Browser OS ir jārestartē, lai lietotu atjauninājumu.</translation>
<translation id="1951406923938785464">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo šī tipa faili parasti netiek lejupielādēti un var būt bīstami.</translation>
<translation id="1953553007165777902">Notiek lejupielāde... Atlikušais laiks: <ph name="MINUTE" /> minūte(-es).</translation>
<translation id="1966382378801805537">Enterprise Browser nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="1990262977744080398">Uzzināt, kāpēc pārlūkā Enterprise Browser daži faili tiek bloķēti (saite tiks atvērta jaunā cilnē)</translation>
<translation id="1999715455684970349">Nodrošina Enterprise Browser programmatūras pastāvīgu atjaunināšanu. Ja šis pakalpojums tiks atspējots vai pārtraukts, jūsu Enterprise Browser programmatūra netiks pastāvīgi atjaunināta, kas nozīmē, ka nebūs iespējams labot drošības ievainojamības, ja tādas radīsies, turklāt var nedarboties funkcijas. Šis pakalpojums pats tiek atinstalēts, ja neviena Enterprise Browser programmatūra to neizmanto.</translation>
<translation id="2008474315282236005">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Enterprise Browser kā <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Instalēšana neizdevās. Lūdzu, mēģiniet vēlreiz.</translation>
<translation id="2020032459870799438">Lai pārbaudītu, vai jūsu pārējās paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Enterprise Browser<ph name="END_LINK" />.</translation>
<translation id="2039417478970545937">Iestatījumi.</translation>
<translation id="2049376729098081731">Izvēlieties, vai iekļaut Enterprise Browser vēsturi, lai iegūtu personalizētākas iespējas Google pakalpojumos.</translation>
<translation id="2054039611381840095">Lai saņemtu turpmākus Enterprise Browser atjauninājumus, nepieciešama operētājsistēma macOS 12 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma macOS 11.</translation>
<translation id="2064856577282482477">Jaunas cilnes lapā noklikšķiniet uz pogas Pielāgot Enterprise Browser, lai piešķirtu pārlūkam Enterprise Browser jaunu izskatu.</translation>
<translation id="2086476982681781442">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo fails ir maldinošs un var veikt neparedzētas izmaiņas jūsu ierīcē.</translation>
<translation id="208726765006323911">Kad nākamreiz iOS ierīcē atvērsiet pārlūku Enterprise Browser, tiks parādīts aicinājums izmēģināt funkciju <ph name="FEATURE_NAME" />.</translation>
<translation id="2099452623287920103">Jūsu paroles un citi Enterprise Browser dati, ko saglabājāt savā Google kontā, tiks noņemti no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Enterprise Browser, atkārtoti pierakstieties.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Enterprise Browser nav izmantots vienu minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}zero{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Enterprise Browser nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}one{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Enterprise Browser nav izmantots # minūti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}other{Jūsu organizācija automātiski dzēš pārlūkošanas datus, ja pārlūks Enterprise Browser nav izmantots # minūtes. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes. Cilnes joprojām būs atvērtas.}}</translation>
<translation id="2126108037660393668">Neizdevās verificēt lejupielādēto failu.</translation>
<translation id="2137162749895930932">Aizvērt tulkošanas ekrānu</translation>
<translation id="215352261310130060">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo vietnē netiek izmantots drošs savienojums un, iespējams, failā ir veiktas izmaiņas.</translation>
<translation id="2174178932569897599">Pielāgot pārlūkprogrammu Enterprise Browser</translation>
<translation id="2174917724755363426">Instalēšana nav pabeigta. Vai tiešām vēlaties atcelt?</translation>
<translation id="2185166961232948079">Enterprise Browser — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Atjauninājumu pārbaudes kļūda: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Noņemt kontu no pārlūka Enterprise Browser</translation>
<translation id="2210502920229141283">Saņemiet labāku aizsardzību, atrodoties ceļā, ar funkciju “Droša pārlūkošana ar papildu aizsardzību” pārlūkā Enterprise Browser operētājsistēmai iOS.</translation>
<translation id="2210682093923538346">Bīstama vietne. Pārlūkā Enterprise Browser tika noņemti paziņojumi.</translation>
<translation id="2236949375853147973">Manas darbības</translation>
<translation id="2238130810669087193">Pierakstieties pārlūkā Enterprise Browser, lai varētu piekļūt adresēm un citiem datiem visās savās ierīcēs. Šī adrese tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="2241627712206172106">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Enterprise Browser atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="2283803047247799269">Meklēt šajā cilnē, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Enterprise Browser iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="2307973900865360088">Paturēt dokā</translation>
<translation id="2313870531055795960">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Enterprise Browser. Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Enterprise Browser var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2332076562712130931">Veicot šo darbību, tiks ieviestas tālāk norādītās izmaiņas.
          <ph name="LINE_BREAKS" />
           • Tiks atiestatīti noteikti Enterprise Browser iestatījumi un Enterprise Browser īsinājumtaustiņi.
           <ph name="LINE_BREAK" />
           • Tiks atspējoti paplašinājumi.
           <ph name="LINE_BREAK" />
           • Tiks dzēsti sīkfaili un citi vietņu pagaidu dati.
            <ph name="LINE_BREAKS" />
           Grāmatzīmes, vēsture un saglabātās paroles netiks ietekmētas.</translation>
<translation id="2343156876103232566">Lai nosūtītu numuru no šejienes uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Enterprise Browser.</translation>
<translation id="2356070529366658676">Vaicāt</translation>
<translation id="2359808026110333948">Turpināt</translation>
<translation id="2361918034042471035">Paplašinājums “<ph name="EXTENSION_NAME" />” pieprasa, lai jūs pierakstītos pārlūkā Enterprise Browser</translation>
<translation id="236943522426971115">Atspējot Enterprise Browser darbību fonā lietotnēm</translation>
<translation id="2374216753258219393">Lai izmantotu šo paplašinājumu kontā <ph name="USER_EMAIL_ADDRESS" />, pierakstieties pārlūkā Enterprise Browser.</translation>
<translation id="2384373936468275798">Enterprise Browser OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Vismaz viens Enterprise Browser paplašinājums piekļuva 1 HID ierīcei}=1{Vismaz viens Enterprise Browser paplašinājums piekļūst 1 HID ierīcei}zero{Vismaz viens Enterprise Browser paplašinājums piekļūst # HID ierīcēm}one{Vismaz viens Enterprise Browser paplašinājums piekļūst # HID ierīcei}other{Vismaz viens Enterprise Browser paplašinājums piekļūst # HID ierīcēm}}</translation>
<translation id="2401032172288869980">Pārlūkam Enterprise Browser ir nepieciešama atļauja izmantot kameru un mikrofonu šajā vietnē.</translation>
<translation id="2403703063067034158">Palaišanas kļūda: pašlaik ir aktīvs cits iestatīšanas process. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="2440750600860946460">Izmantojot <ph name="BEGIN_LINK" />Enterprise Browser rīkus<ph name="END_LINK" />, varat droši pārlūkot saturu un pārvaldīt jums pieejamās iespējas.</translation>
<translation id="2451727308784734061">Izmantojot saīsni, varat ātri piekļūt Google paroļu pārvaldniekam. Varat pārvietot saīsni uz datora sākuma ekrānu vai lietotņu palaidēju.</translation>
<translation id="2478295928299953161">Enterprise Browser drīz tiks aizvērts</translation>
<translation id="2483889755041906834">Pārlūkā Enterprise Browser</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2513154137948333830">Nepieciešama atkārtota palaišana: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Atlasiet tekstu, ko meklēt, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="2554739539410784893">Pārlūkā Enterprise Browser tiek mēģināts aizstāt esošās paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="2560420686485554789">Pārlūkam Enterprise Browser ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="2572494885440352020">Enterprise Browser palīgs</translation>
<translation id="2575822587468774919">Atlasiet jebko, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="2576118232315942160">Pierakstieties pārlūkā Enterprise Browser, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2592940277904433508">Turpināt lietot Enterprise Browser</translation>
<translation id="259935314519650377">Lejupielādēto instalēšanas programmu neizdevās saglabāt kešatmiņā. Kļūda: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Sistēma</translation>
<translation id="2629740064077610681">Jūsu organizācija var skatīt un pārvaldīt pārlūkošanas datus, piemēram, grāmatzīmes, vēsturi un paroles. Tā nevar skatīt pārlūkošanas datus citos Enterprise Browser profilos.</translation>
<translation id="2635452620547538388">Lai izmantotu un saglabātu Enterprise Browser datus savā kontā (<ph name="ACCOUNT_EMAIL" />), apstipriniet savu identitāti.</translation>
<translation id="2637732208198500597">{COUNT,plural, =0{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Enterprise Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots.}=1{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Enterprise Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. Inkognito režīma logs netiks atkārtoti atvērts.}zero{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Enterprise Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}one{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Enterprise Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logs netiks atkārtoti atvērts.}other{Ja tiek izmantota papildu aizsardzība, pārlūkprogramma Enterprise Browser ir jāpalaiž atkārtoti, lai atjauninājums tiktu lietots. # inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="2648074677641340862">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Enterprise Browser vēlreiz.</translation>
<translation id="2661879430930417727">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Enterprise Browser atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="2711502716910134313">Enterprise Browser cilne</translation>
<translation id="2718390899429598676">Papildu drošības nolūkos Enterprise Browser šifrēs jūsu datus.</translation>
<translation id="2721354645805494590">Lai noņemtu savu Google kontu no pārlūka Enterprise Browser, izrakstieties.</translation>
<translation id="2722636413143664436">Pierakstieties pārlūkā Enterprise Browser, lai varētu piekļūt parolēm, grāmatzīmēm un citiem datiem visās savās ierīcēs.</translation>
<translation id="2738871930057338499">Nevar izveidot savienojumu ar internetu. HTTP 403 — aizliegts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="2753623023919742414">Noklikšķiniet, lai meklētu</translation>
<translation id="2768103863314748511">Iestatiet Enterprise Browser kā noklusējuma PDF failu skatītāju.</translation>
<translation id="2785438272836277133">Šis paplašinājums satur ļaunprātīgu programmatūru un nav drošs. Noņemiet to no pārlūka Enterprise Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="2803971713792056305">Jūsu Enterprise Browser</translation>
<translation id="2816462166102338036">Meklēt šo videoklipu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="2841525013647267359">Tulkot no šādas valodas:</translation>
<translation id="2846251086934905009">Instalēšanas kļūda: instalēšanas programma nepabeidza darbu. Instalēšana ir priekšlaikus pārtraukta.</translation>
<translation id="2847479871509788944">Noņemšana no pārlūka Enterprise Browser...</translation>
<translation id="2850691299438350830">Tiek nodrošināta jūsu aizsardzība pārlūkprogrammā Enterprise Browser. Šis režīms var tikt izmantots jūsu drošības uzlabošanai citās Google lietotnēs, kad esat pierakstījies.</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="2910007522516064972">Par &amp;Enterprise Browser</translation>
<translation id="2915996080311180594">Restartēt vēlāk</translation>
<translation id="2928420929544864228">Instalēšana pabeigta.</translation>
<translation id="2933336679234709858">Jūsu dati ir šifrēti, izmantojot ieejas frāzi. Ievadiet ieejas frāzi, lai izmantotu un saglabātu Enterprise Browser datus savā Google kontā.</translation>
<translation id="2945997411976714835">Instalēšanas kļūda: neizdevās palaist instalēšanas programmu.</translation>
<translation id="2948852018303413228">Ātrāk pierakstieties vietnēs, izmantojot saglabātās paroles pārlūkam Enterprise Browser operētājsistēmā iOS.</translation>
<translation id="2966959524256557996">Pievienojiet jaunu Enterprise Browser profilu, lai atsevišķi saglabātu savas grāmatzīmes, paroles un iestatījumus.</translation>
<translation id="2970426615109535079">Pārlūku Enterprise Browser pārvalda jūsu organizācija</translation>
<translation id="2977470724722393594">Enterprise Browser ir atjaunināts</translation>
<translation id="2977506796191543575">Ja kādā vietnē tiek mēģināts nozagt jūsu paroli vai ja jūs lejupielādējat kaitīgu failu, Enterprise Browser var arī nosūtīt attiecīgos URL, tostarp lapas satura fragmentus, uz funkciju Droša pārlūkošana.</translation>
<translation id="2981563588585023386">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pierakstieties pārlūkā Enterprise Browser</translation>
<translation id="3003694935412297923">Visi uzdevumi</translation>
<translation id="3012615494352020668">{count,plural, =1{Pārlūkā Enterprise Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Pārlūkā Enterprise Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Pārlūkā Enterprise Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienums) tiks dzēsti.}other{Pārlūkā Enterprise Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="3013473503895162900">Atveriet vietrādi <ph name="URL" /> jaunā cilnē pārlūkā Enterprise Browser.</translation>
<translation id="3032706164202344641">Pārlūkprogrammā Enterprise Browser nevar pārbaudīt jūsu paroles. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="3032787606318309379">Notiek pievienošana pārlūkam Enterprise Browser...</translation>
<translation id="3038232873781883849">Gaida, lai instalētu...</translation>
<translation id="3045032126857188731">Tulkojuma valoda: <ph name="LANGUAGE" /></translation>
<translation id="3047590466164881923">Aizvērt atsauksmju dialoglodziņu</translation>
<translation id="3068187312562070417">Citi Enterprise Browser profili</translation>
<translation id="3068515742935458733">Palīdzēt uzlabot Enterprise Browser, nosūtot Google serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="3079753320517721795">{NUM_DEVICES,plural, =0{Vismaz viens Enterprise Browser paplašinājums piekļuva 1 USB ierīcei}=1{Vismaz viens Enterprise Browser paplašinājums piekļūst 1 USB ierīcei}zero{Vismaz viens Enterprise Browser paplašinājums piekļūst # USB ierīcēm}one{Vismaz viens Enterprise Browser paplašinājums piekļūst # USB ierīcei}other{Vismaz viens Enterprise Browser paplašinājums piekļūst # USB ierīcēm}}</translation>
<translation id="3095811995836568724">Enterprise Browser vēsture</translation>
<translation id="3103660991484857065">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Enterprise Browser vēlreiz.</translation>
<translation id="310459126943037700">Neizdevās pabeigt uzdevumus.</translation>
<translation id="3130323860337406239">Pārlūkā Enterprise Browser tiek izmantots jūsu mikrofons.</translation>
<translation id="3130333203120345554">Jauns meklējums</translation>
<translation id="3137969841538672700">Velciet, lai meklētu</translation>
<translation id="3144188012276422546">Šī cilne izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Enterprise Browser padarīt to neaktīvu.</translation>
<translation id="3149163023759831301">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Enterprise Browser.</translation>
<translation id="3155163173539279776">Restartēt Enterprise Browser</translation>
<translation id="3161522574479303604">Visas valodas</translation>
<translation id="3179665906251668410">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="3183357154200327217">Cita datorā instalēta programma pievienoja motīvu, kas var ietekmēt pārlūka Enterprise Browser darbību.

<ph name="EXTENSION_NAME" /></translation>
<translation id="3185330573522821672">Pielāgojiet savu jauno Enterprise Browser profilu.</translation>
<translation id="3224847870593914902">Lai noņemtu savu Google kontu no pārlūka Enterprise Browser, lapā “Iestatījumi” izrakstieties no pārlūka Enterprise Browser.</translation>
<translation id="3234316605225071811">Vēlāk pārlūkā Enterprise Browser var tikt vaicāts, vai vēlaties izmantot saglabāto informāciju veidlapu automātiskai aizpildei.</translation>
<translation id="3258596308407688501">Enterprise Browser nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3286538390144397061">Restartēt tūlīt</translation>
<translation id="328888136576916638">Trūkst Google API atslēgu. Tiks atspējotas dažas Enterprise Browser funkcijas.</translation>
<translation id="3296368748942286671">Turpināt lietotņu izpildi fonā, kad Enterprise Browser ir aizvērts</translation>
<translation id="3313189106987092621">Pārlūkā Enterprise Browser tiks parādīts brīdinājums pirms jebkuras vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="3316771292331273802">Aizverot visus Enterprise Browser logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Enterprise Browser. Lai atļautu vietnēm jūs atcerēties, <ph name="SETTINGS_LINK" />.</translation>
<translation id="3322413454779348750">Jūsu noklusējuma meklētājprogramma tika mainīta ārpus pārlūka Enterprise Browser. Lai jūs aizsargātu, tā tika atiestatīta pārlūkā Enterprise Browser.</translation>
<translation id="3352986031709923790">meklēšanas apgabala augšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="TOP" />% augšdaļā</translation>
<translation id="3366305173356742781">Enterprise Browser dati jūsu kontā</translation>
<translation id="3369405342922656244">Meklēt šajā lapā, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="3387527074123400161">Enterprise Browser OS</translation>
<translation id="3406848076815591792">Vai pāriet uz esošo Enterprise Browser profilu?</translation>
<translation id="3412460710772753638">Tā tiks atjaunināta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="3461644266919055473">Notiek Enterprise Browser pielāgošana…</translation>
<translation id="347328004046849135">Ja pierakstīsieties ar uzlauztu paroli, pārlūkprogrammā Enterprise Browser tiks parādīts paziņojums</translation>
<translation id="3474745554856756813">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Enterprise Browser kā <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Lai pārslēgtos starp Enterprise Browser profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="3509308970982693815">Aizveriet visus Enterprise Browser logus un mēģiniet vēlreiz.</translation>
<translation id="3522404737534491619">Lai kopīgotu logu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Enterprise Browser.</translation>
<translation id="3530103706039034513">Jau ir pierakstījies lietotājs <ph name="EXISTING_USER" />.  Lai atdalītu pārlūkošanu, pierakstieties pārlūkā Enterprise Browser savā profilā, izmantojot e-pasta adresi <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="3561853857681580870">Lai kopīgotu ekrānu, sistēmas iestatījumos atļaujiet ekrāna ierakstīšanu pārlūkā Enterprise Browser.</translation>
<translation id="3597003331831379823">Neizdevās izpildīt iestatīšanu ar augstām privilēģijām. <ph name="METAINSTALLER_ERROR" /></translation>
<translation id="3639635944603682591">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Enterprise Browser kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Pieejams Enterprise Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams Enterprise Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams Enterprise Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams Enterprise Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams Enterprise Browser atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3651803019964686660">Lai nosūtītu numuru no vietnes <ph name="ORIGIN" /> uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Enterprise Browser.</translation>
<translation id="3667616615096815454">Nevar instalēt. Lietojumprogramma serverim nav zināma.</translation>
<translation id="3675854891107786059">Izmantot jūsu <ph name="BEGIN_LINK" />ieejas frāzi<ph name="END_LINK" /> visu Enterprise Browser datu šifrēšanai jūsu Google kontā. Maksājumu veidi un adreses no pakalpojuma Google Pay netiks šifrētas. Pārlūkā Enterprise Browser saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="3685209450716071127">Pārlūkprogrammā Enterprise Browser nevar pārbaudīt jūsu paroles. Pārbaudiet interneta savienojumu.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Enterprise Browser.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Enterprise Browser. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Enterprise Browser. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3713809861844741608">Atvērt saiti jaunā Enterprise Browser &amp;cilnē</translation>
<translation id="3728124580182886854">Saistiet pārlūku Enterprise Browser un citus Google pakalpojumus personalizēšanai un citiem mērķiem</translation>
<translation id="3729187154190517324">Padziļiniet meklēšanu, izmantojot pogu “Pievienot cilni un citu kontekstu”, lai pievienotu vairākas cilnes, failus un rīkus.</translation>
<translation id="3788675262216168505">Pārvaldīt Enterprise Browser profilus</translation>
<translation id="3790262771324122253">Uzziniet, kāpēc Enterprise Browser bloķē noteiktas lejupielādes</translation>
<translation id="379589255253486813">Ja kaut kas būs jāpārskata, saņemsiet Enterprise Browser paziņojumu</translation>
<translation id="3798048725356732506">Enterprise Browser profili palīdz nodalīt dažādas jūsu dzīves jomas. Pievienojiet jaunu profilu tūlīt.</translation>
<translation id="3802055581630249637">Pārlūkā Enterprise Browser tiek iepriekš ielādētas lapas, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="3810973564298564668">Pārvaldīt</translation>
<translation id="3846683726093018685">**Apkopošana:** vienā teikumā, kas nepārsniedz 30 vārdus, aprakstiet ekrānuzņēmumā redzamā satura galveno tēmu un nolūku.

          **Jautājumu ieteikšana:** ģenerējiet sarakstu ar aizzīmēm ar 3–5 jautājumiem, kas liek aizdomāties un kurus lietotājs varētu uzdot, lai labāk izprastu ekrānuzņēmumu. Šajos jautājumos ir jābūt vismaz vienam jautājumam, kas ir saistīts ar vizuālu objektu, tā dizainu vai izvietojumu.</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> — Enterprise Browser</translation>
<translation id="3885770153807205175">Valodas atlasītājs</translation>
<translation id="388648406173476553">Pielāgojiet un kontrolējiet pārlūkprogrammu Enterprise Browser. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="3889543394854987837">Noklikšķiniet uz sava vārda, lai atvērtu Enterprise Browser un sāktu pārlūkošanu.</translation>
<translation id="3892148308691398805">Kopēt tekstu</translation>
<translation id="390528597099634151">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Enterprise Browser profilā. Lai atdalītu pārlūkošanu, pārlūkā Enterprise Browser varat sev izveidot atsevišķu profilu.</translation>
<translation id="3909353120217047026">Šis paplašinājums pārkāpj Enterprise Browser interneta veikala politiku, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Enterprise Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="3937491663738985329">P&amp;ielāgot pārlūku Enterprise Browser</translation>
<translation id="3941890832296813527">Instalēšanas kļūda: instalēšanas programmas faila nosaukums nav derīgs vai netiek atbalstīts.</translation>
<translation id="3945058413678539331">Enterprise Browser mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="3954172517175569325">Jūsu Google kontā saglabātās paroles, maksājuma veidi un adreses tiks noņemtas no šīs ierīces. Lai atkal izmantotu šos datus pārlūkā Enterprise Browser, atkārtoti pierakstieties.</translation>
<translation id="395904275706073188">Aizsargātas lapas nevar lasīt. Izmēģiniet citu lapu.</translation>
<translation id="3962647064319009959">Uzziniet, kā Enterprise Browser rūpējas par jūsu drošību</translation>
<translation id="3971865010372729242">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Enterprise Browser nosūta rakstīto tekstu jūsu organizācijas meklēšanas, MI un starpnieku rīkiem, lai iegūtu ieteikumus.</translation>
<translation id="3975724895399328945">Par Enterprise Browser for Testing</translation>
<translation id="3997429360543082038">Par Enterprise Browser OS</translation>
<translation id="4019629340646866719">Enterprise Browser OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="4022972681110646219">Tulkot ekrāna tekstu</translation>
<translation id="4023601594785368013">Oriģinālvaloda: <ph name="LANGUAGE" /></translation>
<translation id="4023845192681161785">Atveriet saites pārlūkā Enterprise Browser no jebkuras lietotnes. Turklāt pārlūks tiks piesprausts uzdevumjoslā, lai nodrošinātu ērtāku piekļuvi.</translation>
<translation id="4036079820698952681">Palīdziet uzlabot pārlūku Enterprise Browser, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4039097928859803404">Vienmēr rādīt MI režīma saīsnes</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="4055805654398742145">P&amp;aroļu pārvaldnieks</translation>
<translation id="4061696872429826774">Cita datorā instalēta programma pievienoja paplašinājumu, kas var ietekmēt pārlūka Enterprise Browser darbību.

<ph name="EXTENSION_NAME" /></translation>
<translation id="4095980151185649725">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots vienu minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}zero{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}one{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūti. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}other{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūtes. Pārlūkošanas dati tiek izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.}}</translation>
<translation id="4118474109249235144">Enterprise Browser inkognito režīms</translation>
<translation id="4122186850977583290">Pāriet uz lapu “Par Enterprise Browser”</translation>
<translation id="4147856324248078748">P&amp;ielāgot pārlūku Enterprise Browser</translation>
<translation id="4148957013307229264">Notiek instalēšana...</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — Enterprise Browser</translation>
<translation id="421369550622382712">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Enterprise Browser.</translation>
<translation id="4217080900579554343">Lai piekļūtu šim paplašinājumam un citiem datiem visos savos datoros, pierakstieties pārlūkā Enterprise Browser.</translation>
<translation id="4217972271355023382">Lai tiktu lietoti jūsu vecāka izvēlētie iestatījumi un jūs tiešsaistē saņemtu labāku aizsardzību, pārslēdzieties uz Enterprise Browser profilu, kurā jau pierakstījāties ar kontu <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="4222932583846282852">Notiek atcelšana...</translation>
<translation id="4224210481850767180">Instalēšana ir atcelta.</translation>
<translation id="4230135487732243613">Vai saistīt Enterprise Browser datus ar šo kontu?</translation>
<translation id="4251772536351901305">Tiek rādīts brīdinājums par bīstamām vietnēm (pat ja Google par tām iepriekš nezināja), analizējot vairāk datu no vietnēm, nekā analizē standarta aizsardzība. Varat izlaist Enterprise Browser brīdinājumus.</translation>
<translation id="4269093074552541569">Izrakstīties no pārlūka Enterprise Browser</translation>
<translation id="4271805377592243930">Saņemt palīdzību par Enterprise Browser</translation>
<translation id="4281844954008187215">Google pakalpojumu noteikumi</translation>
<translation id="4285930937574705105">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Enterprise Browser šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="4298125729853015961">Paroļu eksportēšana no pārlūka Enterprise Browser</translation>
<translation id="4304713468139749426">Paroļu pārvaldnieks</translation>
<translation id="4334241893986177674">Meklēt šajā ekrānuzņēmumā</translation>
<translation id="4334294535648607276">Lejupielāde pabeigta.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> pieprasa, lai pirms šīs ierīces lietošanas jūs izlasītu tālāk sniegtos pakalpojumu sniegšanas noteikumus un piekristu tiem. Šie noteikumi nepaplašina, nepārveido un neierobežo operētājsistēmas Enterprise Browser OS noteikumus.</translation>
<translation id="4407044323746248786">Vai tik un tā aizvērt pārlūku Enterprise Browser?</translation>
<translation id="4413205837991854510">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="4415566066719264597">Ļaut pārlūkam Enterprise Browser darboties fonā</translation>
<translation id="4419831163359812184">{NUM_EXTENSIONS,plural, =1{Enterprise Browser iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}zero{Enterprise Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}one{Enterprise Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}other{Enterprise Browser iesaka tos noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.}}</translation>
<translation id="4423735387467980091">Pielāgot un kontrolēt Enterprise Browser</translation>
<translation id="4427306783828095590">Uzlabotā aizsardzība labāk bloķē pikšķerēšanas mēģinājumus un ļaunprātīgu programmatūru</translation>
<translation id="4434353761996769206">Instalēšanas kļūda: <ph name="INSTALLER_ERROR" /></translation>
<translation id="4438870983368648614">Pārlūku Enterprise Browser pārvalda organizācija “<ph name="MANAGER" />”</translation>
<translation id="444069871276811466">Pievienot Enterprise Browser profilu</translation>
<translation id="4447409407328223819">Par Enterprise Browser for Testing</translation>
<translation id="4470974262661801543">Lai izmantotu un saglabātu Enterprise Browser datus savā Google kontā, ievadiet ieejas frāzi.</translation>
<translation id="4493028449971051158">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā administrators.</translation>
<translation id="4501471624619070934">Instalēšana neizdevās, jo šajā valstī piekļuve ir ierobežota.</translation>
<translation id="4510853178268397146">Nav norādīta konfidencialitātes prakse šim paplašinājumam, piemēram, kā tas vāc un izmanto datus. Enterprise Browser iesaka to noņemt.</translation>
<translation id="452711251841752011">Laipni lūdzam pārlūkā Enterprise Browser (tika atvērts jauns pārlūka logs)!</translation>
<translation id="4531137820806573936">Pārlūkam Enterprise Browser ir nepieciešama atļauja jūsu apkārtnes kartēšanai un roku kustību izsekošanai</translation>
<translation id="4534145890176164066">Enterprise Browser labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt.</translation>
<translation id="4536805923587466102">Ar kontu <ph name="USER_EMAIL_ADDRESS" /> jau esat pierakstījies citā Enterprise Browser profilā</translation>
<translation id="4548534452171747496">Pārlūkā Enterprise Browser tiek iepriekš ielādētas lapas, tādējādi paātrinot pārlūkošanu un meklēšanu. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par lapu iepriekšēju ielādi<ph name="END_LINK" />.</translation>
<translation id="4567424176335768812">Jūs esat pierakstījies kā <ph name="USER_EMAIL_ADDRESS" />. Tagad varat piekļūt savām grāmatzīmēm, vēsturei un citiem iestatījumiem visās ierīcēs, kurās esat pierakstījies.</translation>
<translation id="4570813286784708942">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo jūs izslēdzāt drošu pārlūkošanu un failu nevar verificēt.</translation>
<translation id="4594305310729380060">Tā tiks saglabāta Paroļu pārvaldniekā šajā ierīcē</translation>
<translation id="459535195905078186">Enterprise Browser lietotnes</translation>
<translation id="4598116752460667024">Sarakstā meklējiet jebkuru procesu.</translation>
<translation id="4613863813562375431">Enterprise Browser OS versija</translation>
<translation id="4621240073146040695">Atjaunināšana ir gandrīz pabeigta. Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūku Enterprise Browser.</translation>
<translation id="4625064703209785397">Paātrina vietņu darbību, izmantojot Enterprise Browser programmu V8, taču nedaudz samazina Enterprise Browser izturību pret uzbrukumiem.</translation>
<translation id="4654936675281451226">Enterprise Browser labāk izprot veidlapas un var ātrāk tās automātiski aizpildīt. Šis iestatījums ir ieslēgts.</translation>
<translation id="4665829708273112819">Brīdinājums! Enterprise Browser nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="4673151026126227699">Ja kopīgojat arī Enterprise Browser lietojuma pārskatus, šajos pārskatos tiek iekļauti jūsu apmeklētie vietrāži URL.</translation>
<translation id="4677944499843243528">Šķiet, ka profils tiek izmantots citā Enterprise Browser procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā Enterprise Browser tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Enterprise Browser.</translation>
<translation id="4680828127924988555">Atcelt instalēšanu</translation>
<translation id="469259825538636168">Noteikti jūsu Enterprise Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="4708193446201257833">Kamēr esat pierakstījies, pārlūkā Enterprise Browser varat izmantot savas paroles un citu saturu no Google konta. <ph name="SHORTCUT" /> var mainīt jūsu Google pakalpojumu iestatījumus.</translation>
<translation id="4708774505295300557">Kāds iepriekš pierakstījās pārlūkā Enterprise Browser šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu Enterprise Browser lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4724676981607797757">Instalēšana neizdevās, jo radās neatbalstīta protokola kļūda.</translation>
<translation id="4746050847053251315">Vai tik un tā aizvērt pārlūku Enterprise Browser?</translation>
<translation id="4748217263233248895">Tikko tika piemērots īpašs Enterprise Browser drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4759645701210484457">Jautāt Enterprise Browser</translation>
<translation id="4771701986670315895">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Enterprise Browser tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" /> un vēl <ph name="COUNT" />.</translation>
<translation id="4788777615168560705">Pārlūkprogrammā Enterprise Browser nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām vai <ph name="BEGIN_LINK" />pārbaudiet paroles savā Google kontā<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Google meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Google serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="4814736265800133385">Izmantot Enterprise Browser, nepierakstoties kontā</translation>
<translation id="4888717733111232871">Ienākošo savienojumu kārtula pārlūkam Enterprise Browser, lai atļautu mDNS datplūsmu.</translation>
<translation id="4893347770495441059">Atkārtoti palaist, lai atjauninātu &amp;Enterprise Browser</translation>
<translation id="4918844574251943176">Attēls ir nokopēts</translation>
<translation id="4943838377383847465">Enterprise Browser darbojas fona režīmā.</translation>
<translation id="494490797786467921">Noklikšķiniet, lai aizvērtu Enterprise Browser pierakstīšanās dialoglodziņu</translation>
<translation id="4950660488495335294">Izmantojot Enterprise Browser profilus, varat nodalīt visu savu Enterprise Browser saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="4987820182225656817">Viesi var izmantot Enterprise Browser, neatstājot nekādas pēdas.</translation>
<translation id="4992938037305302429">Jūsu konts pārlūkā Enterprise Browser</translation>
<translation id="4994636714258228724">Pievienot savu kontu pārlūkā Enterprise Browser</translation>
<translation id="5123973130450702873">Pārlūkam Enterprise Browser ir nepieciešama atļauja izsekot jūsu roku kustības.</translation>
<translation id="5141988424377517949">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Enterprise Browser tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />, <ph name="PERMISSION_3" />.</translation>
<translation id="5167819546851111585">Kas jums šodien padomā?</translation>
<translation id="5174969993834422967">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet uz paziņojumu ikonas atrašanās vietas joslas labajā stūrī.</translation>
<translation id="5174983315706567306">Diskā nepietiek brīvas vietas.</translation>
<translation id="5187123684706427865">Enterprise Browser kontam nepieciešama atkārtota autentifikācija</translation>
<translation id="5224391634244552924">Nav saglabātu paroļu. Pārlūkprogrammā Enterprise Browser var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="5231355151045086930">Izrakstīšanās no Enterprise Browser</translation>
<translation id="5234764350956374838">Nerādīt</translation>
<translation id="5254739261293693943">Uzdot jautājumus par šo videoklipu</translation>
<translation id="5277894862589591112">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Enterprise Browser.</translation>
<translation id="5286907366254680517">Noteiktā valoda</translation>
<translation id="5294316920224716406">Ja veicat pārlūkošanu inkognito režīmā, pārlūkā Enterprise Browser tiks parādīts brīdinājums pirms vietnes ielādes, izmantojot nedrošu savienojumu.</translation>
<translation id="5313228254328109263">Enterprise Browser atjauninātājs: iekšējais pakalpojums</translation>
<translation id="5346389065299425353">Padziļiniet meklēšanu, pievienojot vairākas cilnes, failus un rīkus.</translation>
<translation id="5352264705793813212">Pārlūkā Enterprise Browser tika atrasti daži drošības ieteikumi par jūsu atsauksmi</translation>
<translation id="5352361688875342522">Citi Enterprise Browser profili</translation>
<translation id="5358375970380395591">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Enterprise Browser dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5368118228313795342">Papildu kods: <ph name="EXTRA_CODE" />.</translation>
<translation id="5377622451696208284">Lai izmantotu personalizēšanu, iekļaujiet pārlūku Enterprise Browser iestatījumā “Darbības tīmeklī un lietotnēs”</translation>
<translation id="5383439451358640070">Uzzināt, kāpēc pārlūkā Enterprise Browser daži faili tiek bloķēti</translation>
<translation id="5386450000063123300">Notiek Enterprise Browser atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Atļaut pierakstīties pārlūkā Enterprise Browser</translation>
<translation id="5405650547142096840">Noņemt no pārlūka Enterprise Browser</translation>
<translation id="5424544524441439284">Samazina veiktspēju, taču uzlabo Enterprise Browser izturību pret uzbrukumiem.</translation>
<translation id="5427571867875391349">Iestatīt Enterprise Browser kā noklusējuma pārlūku</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Enterprise Browser beta versija</translation>
<translation id="5460618461609401056">{NUM_TABS,plural, =1{Enterprise Browser iesaka pārtraukt tās cilnes darbību, kas palēnina pārlūka darbību}zero{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}one{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}other{Enterprise Browser iesaka pārtraukt to ciļņu darbību, kas palēnina pārlūka darbību}}</translation>
<translation id="5473971139929175403">Iespējams, pārlūks Enterprise Browser nedarbosies pareizi, jo tas vairs netiek atbalstīts šajā Linux izdevumā.</translation>
<translation id="5475924890392386523">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo šis fails var kaitēt jūsu personīgajiem un sociālo tīklu kontiem</translation>
<translation id="5480860683791598150">Pārlūkam Enterprise Browser ir nepieciešama piekļuve jūsu atrašanās vietas datiem, lai varētu tos kopīgot ar šo vietni.</translation>
<translation id="549669000822060376">Lūdzu, uzgaidiet, kamēr Enterprise Browser instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="5496810170689441661">Enterprise Browser mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="5524890928877629608">meklēšanas apgabala augšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="TOP" />% augšdaļā</translation>
<translation id="5527463683072221100">Atvērt PDF failus pārlūkā Enterprise Browser</translation>
<translation id="5536164441519929134">Jautājiet<ph name="LINE_BREAK" />par šo cilni</translation>
<translation id="5579324208890605088">Palaišanas kļūda: lūdzu, palaidiet instalēšanas programmu kā parasts lietotājs, nevis kā administrators.</translation>
<translation id="5580770360767802657">Izmantojiet pārlūku Enterprise Browser pēc noklusējuma un piespraudiet to</translation>
<translation id="5596627076506792578">Citas opcijas</translation>
<translation id="5605834417512968703">Atlasiet jebko, ko vēlaties meklēt, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5618818588972826921">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana, vai nospiediet atsoļa taustiņu, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5623402015214259806">{0,plural, =0{Ir pieejams Enterprise Browser atjauninājums}=1{Ir pieejams Enterprise Browser atjauninājums}zero{Enterprise Browser atjauninājums ir pieejams jau # dienu}one{Enterprise Browser atjauninājums ir pieejams jau # dienu}other{Enterprise Browser atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="5633450273457573375">Izmantot jūsu <ph name="BEGIN_LINK" />ieejas frāzi<ph name="END_LINK" /> visu Enterprise Browser datu šifrēšanai jūsu Google kontā. Adreses un visi dati, kas saglabāti lietotnē Google maks, netiks šifrēti, izmantojot jūsu ieejas frāzi. Pārlūkā Enterprise Browser saglabātā pārlūkošanas vēsture netiks sinhronizēta.</translation>
<translation id="5643865575100044307">Vienmēr notīrīt vietnes datus no ierīces, kad tiek aizvērts pārlūks Enterprise Browser</translation>
<translation id="5653831366781983928">Lūdzu, nekavējoties restartējiet pārlūku Enterprise Browser</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5698481217667032250">Rādīt Enterprise Browser šajā valodā</translation>
<translation id="569897634095159764">Nevar izveidot savienojumu ar internetu. Starpniekserverī ir nepieciešama autentifikācija.</translation>
<translation id="5713518899297503106">Izmantojot Enterprise Browser profilus, varat nošķirt pārlūkošanu darba un personīgajām vajadzībām. Pievienojiet jaunu profilu tūlīt.</translation>
<translation id="5768371961535086509">Pārlūkā Enterprise Browser neaktīvās cilnēs tiek atbrīvota atmiņa. Tādējādi aktīvajām cilnēm un citām lietotnēm tiek nodrošināts vairāk datora resursu un tiek uzlabots Enterprise Browser darbības ātrums. Neaktīvās cilnes atkal tiek automātiski aktivizētas, kad tās atverat. Varat <ph name="BEGIN_LINK" />uzzināt vairāk par atmiņas taupīšanas režīmu<ph name="END_LINK" />.</translation>
<translation id="5775198138441669627">Ja aizmirsāt ieejas frāzi vai vēlaties mainīt šo iestatījumu, varat <ph name="SETTINGS_LINK" /> Enterprise Browser datus savā kontā.</translation>
<translation id="5800158606660203929">Pielāgojiet un kontrolējiet pārlūku Enterprise Browser. Iestatiet Enterprise Browser kā noklusējuma pārlūku.</translation>
<translation id="5809516625706423866">Nevar izveidot savienojumu ar internetu. HTTP 401 — neatļauts. Lūdzu, pārbaudiet starpniekservera konfigurāciju.</translation>
<translation id="5817952762723416573">Paātrina vietņu darbību, izmantojot Enterprise Browser programmu V8, bet nedaudz samazina Enterprise Browser izturību pret uzbrukumiem. Šis iestatījums ir izslēgts.</translation>
<translation id="5821520528363214608">Lai izmantotu un saglabātu Enterprise Browser datus Google kontā, atjauniniet pārlūku Enterprise Browser.</translation>
<translation id="5824893331272123205">Nevarēja ielādēt šo paneli. Mēģiniet vēlreiz.</translation>
<translation id="5862307444128926510">Laipni lūdzam pārlūkā Enterprise Browser!</translation>
<translation id="5871205389137001634">Noklikšķiniet, lai izietu no funkcijas Attēlu meklēšana</translation>
<translation id="5883558403894052917">Pārlūkā Enterprise Browser tika konstatēts, ka tālāk norādītie vienumi satur ļaunprātīgu programmatūru:</translation>
<translation id="5889361821821684993">Enterprise Browser regulāri pārbauda, vai pārlūkā ir atlasīti visdrošākie iestatījumi. Ja kaut kas būs jāpārskata, saņemsiet paziņojumu.</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5924017743176219022">Notiek savienojuma izveide ar internetu...</translation>
<translation id="5941711191222866238">Minimizēt</translation>
<translation id="5949225980829865667">Lai varētu izmantot šo grāmatzīmi un citus datus visās savās ierīcēs, pierakstieties pārlūkā Enterprise Browser.</translation>
<translation id="5953657885167112863">Enterprise Browser personalizēšana</translation>
<translation id="5960071705175224773">Jūsu iestatījumus mainīja nezināma lietotne</translation>
<translation id="5968400720580217226">MI režīms</translation>
<translation id="5986585015444752010">{COUNT,plural, =1{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots vienu minūti.}zero{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūtes.}one{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūti.}other{Jūsu organizācija automātiski aizver pārlūku Enterprise Browser, ja tas nav izmantots # minūtes.}}</translation>
<translation id="5987687638152509985">Lai sāktu sinhronizēšanu, atjauniniet Enterprise Browser.</translation>
<translation id="6003112304606738118">Notiek lejupielāde... Atlikušais laiks: <ph name="HOURS" /> stunda(-as).</translation>
<translation id="6009821354356307391">Uzdot papildu jautājumu</translation>
<translation id="6040143037577758943">Aizvērt</translation>
<translation id="6058380562449900225">Lai aizsargātu savus datus, ļaujiet pārlūkā Enterprise Browser atsaukt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis (paziņojumi netiks bloķēti)</translation>
<translation id="6063093106622310249">&amp;Atvērt pārlūkā Enterprise Browser</translation>
<translation id="6069027071882229820">Kopēt kā attēlu</translation>
<translation id="6072279588547424923">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam Enterprise Browser</translation>
<translation id="6072463441809498330">Pārlūka Enterprise Browser darbības paātrināšana</translation>
<translation id="6096348254544841612">Pielāgojiet un pārvaldiet pārlūku Enterprise Browser. Ir pieejams atjauninājums.</translation>
<translation id="6107893135096467929">Ieslēgts • Enterprise Browser nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="611228897408671387">Jūsu konts pārlūkā Enterprise Browser</translation>
<translation id="6119438414301547735">Atļaut paplašinājumam rādīt piekļuves pieprasījumus Enterprise Browser rīkjoslā</translation>
<translation id="6129621093834146363">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ Enterprise Browser to bloķēja.</translation>
<translation id="6132897690380286411">Enterprise Browser drīz tiks aizvērts, un dati tiks izdzēsti</translation>
<translation id="6145820983052037069">Šeit varat pārslēgties starp Enterprise Browser profiliem.</translation>
<translation id="615103374448673771">Ja atļaujat sīkfailus, pārlūks Enterprise Browser var tos izmantot iepriekšējai ielādei.</translation>
<translation id="6165508094623778733">Uzzināt vairāk</translation>
<translation id="6173308241973263798">Notīrīt Enterprise Browser datus savā kontā</translation>
<translation id="6174920971222007286">Šis fails var būt bīstams.<ph name="LINE_BREAK" />Enterprise Browser var pārbaudīt šo lejupielādi, ja norādīsiet paroli. Informācija par failu tiek nosūtīta funkcijai “Google droša pārlūkošana”, taču faila saturs un parole paliek jūsu ierīcē.</translation>
<translation id="6182736845697986886">Instalēšana neizdevās, jo radās atjauninājumu servera iekšēja kļūda.</translation>
<translation id="6183079672144801177">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā Enterprise Browser un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="6204922163963157461">Cita datorā instalēta programma pievienoja lietotni, kas var ietekmēt pārlūka Enterprise Browser darbību.

<ph name="EXTENSION_NAME" /></translation>
<translation id="6212496753309875659">Šim datoram jau ir jaunākā Enterprise Browser versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Enterprise Browser un mēģiniet vēlreiz.</translation>
<translation id="6219195342503754812">{0,plural, =0{Pārlūks Enterprise Browser tūlīt tiks restartēts}=1{Pārlūks Enterprise Browser pēc 1 sekundes tiks restartēts}zero{Pārlūks Enterprise Browser pēc # sekundēm tiks restartēts}one{Pārlūks Enterprise Browser pēc # sekundes tiks restartēts}other{Pārlūks Enterprise Browser pēc # sekundēm tiks restartēts}}</translation>
<translation id="6239161312595354541">Jautāt attēlu meklēšanas funkcijai par šo videoklipu</translation>
<translation id="6241367896540709610">Pārlūkam Enterprise Browser ir nepieciešama atļauja piekļūt krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="6245734527075554892">Vietrāži URL tiek pārbaudīti, salīdzinot ar nedrošo vietņu sarakstu, kas ir saglabāts pārlūkprogrammā Enterprise Browser.</translation>
<translation id="6248213926982192922">Padarīt Enterprise Browser par noklusējuma pārlūku</translation>
<translation id="6268381023930128611">Vai izrakstīties no Enterprise Browser?</translation>
<translation id="6270547683008298381">Šīs cilnes izmanto papildu resursus. Lai uzlabotu veiktspēju, ļaujiet pārlūkam Enterprise Browser padarīt tās neaktīvas.</translation>
<translation id="6281746429495226318">Pielāgot Enterprise Browser profilu</translation>
<translation id="6290827346642914212">Enterprise Browser profila nosaukšana</translation>
<translation id="6294831894865512704">Viens no paplašinājumiem pieprasa, lai jūs pierakstītos pārlūkā Enterprise Browser</translation>
<translation id="6295779123002464101">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ Enterprise Browser to bloķēja.</translation>
<translation id="6309712487085796862">Enterprise Browser saitē tiek izmantota kamera.</translation>
<translation id="6327105987658262776">Atjauninājums nav pieejams.</translation>
<translation id="6333502561965082103">Tiek veikta cita darbība pārlūkā Enterprise Browser. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="6334986366598267305">Tagad pārlūkā Enterprise Browser ir vieglāk izmantot Google kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="6347933965114150440">Enterprise Browser saīsne</translation>
<translation id="6366160072964553914">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo fails parasti netiek lejupielādēts un var būt bīstams.</translation>
<translation id="6373523479360886564">Vai tiešām vēlaties atinstalēt pārlūku Enterprise Browser?</translation>
<translation id="6375219077595103062">Saīsnes pievienošana paroļu pārvaldniekam</translation>
<translation id="6388799252195623474">palīdzēt man ar šo</translation>
<translation id="6390800440335263989">Lai turpinātu, pierakstieties pārlūkā Enterprise Browser ar kontu <ph name="EMAIL" />. Tas nodrošinās jūsu organizācijas politiku ievērošanu.</translation>
<translation id="6400112897226594999">Enterprise Browser logotips datora ekrānā.</translation>
<translation id="6403826409255603130">Enterprise Browser ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Enterprise Browser.</translation>
<translation id="642132557830635295">Enterprise Browser darbojas ātrāk, un funkcijas, kurās tiek izmantota valoda JavaScript, darbojas paredzētajā veidā</translation>
<translation id="6436260184216827876">Funkcija Attēlu meklēšana nav pieejama. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="6442900851116057561">Enterprise Browser OS restartēšana</translation>
<translation id="6443470774889161065">Pārlūkā Enterprise Browser tiek iepriekš ielādēts vēl vairāk lapu, ko jūs, iespējams, apmeklēsiet. Tādējādi var tās ielādēt ātrāk tad, kad tās tiešām apmeklējat.</translation>
<translation id="645458117210240797">Izslēgts • Enterprise Browser nevar pārbaudīt šī paplašinājuma izcelsmi</translation>
<translation id="6455857529632101747">Laipni lūdzam Enterprise Browser profilos!</translation>
<translation id="6466344609055215035">Noņemt kontu no pārlūka Enterprise Browser</translation>
<translation id="6475912303565314141">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Enterprise Browser.</translation>
<translation id="648319183876919572">Droša pārlūkošana ar papildu aizsardzību nodrošina efektīvāku aizsardzību pret bīstamām vietnēm un lejupielādēm</translation>
<translation id="6510925080656968729">Atinstalēt Enterprise Browser</translation>
<translation id="651535675648445253">Saīsnes tiek atvērtas pārlūkā Enterprise Browser</translation>
<translation id="6539122709674868420">Jūsu organizācija aizver pārlūku Enterprise Browser, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots. Pārlūkošanas dati tika izdzēsti. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="6542839706527980775">Katrā profilā tiek glabāta attiecīgā Enterprise Browser profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6563921047760808519">Uzziniet vairāk par to, <ph name="BEGIN_LINK" />kā pārlūkā Enterprise Browser tiek saglabāta jūsu datu konfidencialitāte<ph name="END_LINK" />.</translation>
<translation id="6564039629497156115">Šī iestatījuma izmaiņas tiks lietotas pēc pārlūka Enterprise Browser restartēšanas.</translation>
<translation id="656935081669708576">Varat pārslēgties, lai skatītu paroles no cita Enterprise Browser profila.</translation>
<translation id="6570579332384693436">Lai izlabotu pareizrakstības kļūdas, Enterprise Browser nosūta teksta laukos ievadīto tekstu Google serveriem.</translation>
<translation id="6598877126913850652">Pāriet uz Enterprise Browser paziņojumu iestatījumiem</translation>
<translation id="6600016381025017075">Meklēt informāciju par jebkuru šīs lapas satura daļu</translation>
<translation id="6613594504749178791">Izmaiņas stāsies spēkā, kad restartēsiet Enterprise Browser.</translation>
<translation id="6648212540664651655">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Enterprise Browser tika atjaunotas cilnes no jūsu pēdējās sesijas. Varat to izslēgt lapā</translation>
<translation id="665732753414869868">Pārlūkam Enterprise Browser ir nepieciešama atļauja izmantot kameru, lai varētu izveidot jūsu apkārtnes 3D karti.</translation>
<translation id="6669284030132180248">Ja saglabāsiet grāmatzīmes arī Google kontā, varēsiet izsekot produktu cenām pārlūkā Enterprise Browser un saņemt paziņojumus par cenu kritumiem.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="668175097507315160">Enterprise Browser OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="6691132793308828750">Noņemt šo lietotņu datus no Enterprise Browser</translation>
<translation id="6692797197837897398">Enterprise Browser nodrošina lielāku kontroli pār jums rādītajām reklāmām un ierobežo informāciju, ko vietnes var uzzināt par jums, kad tās rāda jums personalizētas reklāmas.</translation>
<translation id="6709350901466051922">Pārlūkam Enterprise Browser ir nepieciešama atļauja izmantot mikrofonu šajā vietnē.</translation>
<translation id="6712881677154121168">Lejupielādes kļūda: <ph name="DOWNLOAD_ERROR" />.</translation>
<translation id="6717134281241384636">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Enterprise Browser versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Enterprise Browser versiju.</translation>
<translation id="6729124504294600478">Lai varētu izmantot personalizēšanu un citas funkcijas, iekļaujiet pārlūku Enterprise Browser iestatījumos “Darbības tīmeklī un lietotnēs” un “Saistītie Google pakalpojumi”.</translation>
<translation id="6734291798041940871">Pārlūks Enterprise Browser jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="6742093177587589736">Pierakstieties pārlūkā Enterprise Browser, lai varētu piekļūt grāmatzīmēm un citiem datiem visās savās ierīcēs. Šī grāmatzīme tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="6751374565094704799">Paātrina vietņu darbību, izmantojot Enterprise Browser programmu V8, bet nedaudz samazina Enterprise Browser izturību pret uzbrukumiem. Šis iestatījums ir ieslēgts.</translation>
<translation id="6754665438209053659">{count,plural, =1{Noteikti jūsu Enterprise Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati (1 vienums) tiks dzēsti.}zero{Noteikti jūsu Enterprise Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumu) tiks dzēsti.}one{Noteikti jūsu Enterprise Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumus) tiks dzēsti.}other{Noteikti jūsu Enterprise Browser dati vēl nav saglabāti jūsu Google kontā. Pirms izrakstāties, uzgaidiet dažas minūtes. Ja izrakstīsieties tūlīt, šie dati ({count} vienumi) tiks dzēsti.}}</translation>
<translation id="67706546131546258">Enterprise Browser iesaka pārbaudīt šo failu, jo tas var būt bīstams.</translation>
<translation id="6779406956731413166">Enterprise Browser OS darbību nodrošina papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6831043979455480757">Tulkot</translation>
<translation id="6847869444787758381">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Enterprise Browser saņemsiet paziņojumu</translation>
<translation id="684888714667046800">Nevar izveidot savienojumu ar internetu. Ja izmantojat ugunsmūri, failam <ph name="PRODUCT_EXE_NAME" /> noteikti ir jābūt iekļautam atļaušanas sarakstā.</translation>
<translation id="6857782730669500492">Enterprise Browser — <ph name="PAGE_TITLE" /></translation>
<translation id="6859580922007887573">Nospiediet tabulēšanas taustiņu, lai turpinātu</translation>
<translation id="6862030660799253820">Meklēt šo attēlu, izmantojot attēlu meklēšanas funkciju</translation>
<translation id="6873893289264747459">Pārlūkā Enterprise Browser tika konstatēts, ka paplašinājums “<ph name="EXTENSION_NAME" />” satur ļaunprātīgu programmatūru.</translation>
<translation id="6877155553248388166">meklēšanas apgabala apakšējais labais stūris: <ph name="RIGHT" />% pa labi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="6896758677409633944">Kopēt</translation>
<translation id="6901631050894301805">Iestatiet Enterprise Browser kā noklusējuma pārlūku un piespraudiet to uzdevumjoslai</translation>
<translation id="6909503629704372277">&amp;Pārvaldīt Enterprise Browser profilus</translation>
<translation id="6934579572334859869">Jautāt attēlu meklēšanas funkcijai par šo attēlu</translation>
<translation id="6964305034639999644">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6965382102122355670">Labi</translation>
<translation id="6978145336957848883">Nedrošas paroles ir viegli uzminēt. Pārlūkā Enterprise Browser <ph name="BEGIN_LINK" />var automātiski veidot un iegaumēt drošas paroles jūsu kontiem<ph name="END_LINK" />.</translation>
<translation id="6985329841647292029">Enterprise Browser OS noteikumi</translation>
<translation id="6990124437352146030">Pārlūkam Enterprise Browser ir nepieciešama atļauja piekļūt jūsu mikrofonam šajā vietnē.</translation>
<translation id="7003299027384820442">Lai savā kontā (<ph name="ACCOUNT_EMAIL" />) izmantotu un saglabātu Enterprise Browser datus, ievadiet ieejas frāzi.</translation>
<translation id="7011190694940573312">Instalēšana neizdevās, jo šī operētājsistēmas versija netiek atbalstīta.</translation>
<translation id="7024536598735240744">Atpakošanas kļūda: <ph name="UNPACK_ERROR" />.</translation>
<translation id="7025789849649390912">Instalēšana apturēta.</translation>
<translation id="7045244423563602563">Pielāgojiet pārlūku Enterprise Browser savām vajadzībām</translation>
<translation id="7047386856539490735">Vai šie rezultāti ir noderīgi?</translation>
<translation id="705851970750939768">Atjaunināt Enterprise Browser</translation>
<translation id="7067091210845072982">Ja attēlam nav vērtīga apraksta, pārlūks Enterprise Browser mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google.</translation>
<translation id="7141270731789036260">Pielāgot versiju Enterprise Browser for Testing</translation>
<translation id="7147227333672430807">Varat izmantot pārlūku Enterprise Browser ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs.</translation>
<translation id="7163519456498498587">Noņemt paplašinājumu <ph name="EXTENSION_NAME" /> no pārlūka Enterprise Browser</translation>
<translation id="7173822816570314652">Jūsu organizācija dzēš Enterprise Browser datus, ja šis pārlūks <ph name="TIMEOUT_DURATION" /> netiek izmantots. Tie var ietvert vēsturi, automātiskās aizpildes datus un lejupielādes.</translation>
<translation id="718435575166326686">Pārlūkam Enterprise Browser ir nepieciešama atļauja izmantot kameru šajā vietnē.</translation>
<translation id="7196312274710523067">Neizdevās palaist Enterprise Browser. Mēģiniet vēlreiz.</translation>
<translation id="7197677400338048821">Pārlūkprogrammā Enterprise Browser nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām.</translation>
<translation id="7213008767289637091">Paturiet pārlūku Enterprise Browser dokā, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="7213407614656404070">Izmantojiet Enterprise Browser ikreiz, kad noklikšķināt uz saitēm ziņojumos, dokumentos un citās lietotnēs</translation>
<translation id="7223968959479464213">Uzdevumu pārvaldnieks — Enterprise Browser</translation>
<translation id="7246575524853130370">Jūsu intereses, kas aptuveni noteiktas pārlūkā Enterprise Browser</translation>
<translation id="7274695763216404502">Piesprausts! Varat atkal piekļūt funkcijai Attēlu meklēšana no rīkjoslas.</translation>
<translation id="7288567540154601580">Cilnes un paplašinājumi</translation>
<translation id="7295544978856094497">{NUM_EXTENSIONS,plural, =1{Enterprise Browser iesaka to noņemt.}zero{Enterprise Browser iesaka tos noņemt.}one{Enterprise Browser iesaka tos noņemt.}other{Enterprise Browser iesaka tos noņemt.}}</translation>
<translation id="7296334833518879294">Lai kopīgotu sistēmas audio, pārejiet uz sistēmas iestatījumiem un iespējojiet iestatījumu “Tikai sistēmas audio ierakstīšana” pārlūkam Enterprise Browser. Pēc tam jums būs jārestartē pārlūks Enterprise Browser.</translation>
<translation id="7309928523159922338">Reklāmu izvērtēšana ļauj jūsu apmeklētajām vietnēm pieprasīt informāciju no Enterprise Browser, lai efektīvāk novērtētu vietnēs rādīto reklāmu veiktspēju. Reklāmu izvērtēšana ierobežo starpvietņu izsekošanu, pārsūtot starp vietnēm pēc iespējas mazāk informācijas.</translation>
<translation id="731795002583552498">Notiek Enterprise Browser atjaunināšana</translation>
<translation id="7318036098707714271">Jūsu preferenču fails ir bojāts vai nederīgs. Enterprise Browser nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7339898014177206373">Jauns logs</translation>
<translation id="734373864078049451">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Enterprise Browser saturs.</translation>
<translation id="7347827960336370838">Jūsu šifrētos datus var lasīt tikai personas, kurām ir jūsu ieejas frāze. Ieejas frāze netiek sūtīta uzņēmumam Google, un uzņēmums Google to neuzglabā. Ja aizmirsīsiet ieejas frāzi vai vēlēsieties mainīt šo iestatījumu, jums būs <ph name="BEGIN_LINK" />jāizdzēš Enterprise Browser dati savā kontā<ph name="END_LINK" />.</translation>
<translation id="7349591376906416160">Jūsu sistēmas administrators ir konfigurējis Enterprise Browser atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7352651011704765696">Radās problēma</translation>
<translation id="7376384068949534168">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Enterprise Browser tika noņemtas šādas atļaujas: <ph name="PERMISSION_1" />, <ph name="PERMISSION_2" />.</translation>
<translation id="7384121030444253939">Šis paplašinājums vairs netiek atbalstīts. Enterprise Browser iesaka to noņemt.</translation>
<translation id="7413153308467572558">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Enterprise Browser tiek atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to izslēgtu, pārejiet uz lapu</translation>
<translation id="7427879960656355200">Paroļu importēšana pārlūkā Enterprise Browser</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> — Enterprise Browser izstrādātāju versija</translation>
<translation id="7450541714075000668">Teksts ir nokopēts</translation>
<translation id="7451052299415159299">Pārlūkam Enterprise Browser ir nepieciešama atļauja piekļūt jūsu kamerai šajā vietnē.</translation>
<translation id="7458892263350425044">Lai izmantotu mikrofonu, piešķiriet pārlūkam Enterprise Browser piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="7461356015007898716">Lai saņemtu turpmākus Enterprise Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 7.</translation>
<translation id="7467949745582939695">Vai atkārtoti palaist Enterprise Browser?</translation>
<translation id="7483335560992089831">Nevar instalēt to pašu Enterprise Browser versiju, kas jau šobrīd darbojas. Aizveriet Enterprise Browser un mēģiniet vēlreiz.</translation>
<translation id="7517403744065880907">Jūs saglabāsiet un izmantosiet paroles un citu saturu savā Google kontā, kad vien būsiet pierakstījies pārlūkā Enterprise Browser. <ph name="LEARN_MORE" /></translation>
<translation id="751935028865900641">Vietnes, visticamāk, darbosies, kā paredzēts. Aizverot visus Enterprise Browser logus, automātiski izrakstīsieties no lielākās daļas vietņu, bet ne no Google konta, ja esat pierakstījies pārlūkā Enterprise Browser.</translation>
<translation id="753534427205733210">{0,plural, =1{Pārlūks Enterprise Browser pēc 1 minūtes tiks restartēts}zero{Pārlūks Enterprise Browser pēc # minūtēm tiks restartēts}one{Pārlūks Enterprise Browser pēc # minūtes tiks restartēts}other{Pārlūks Enterprise Browser pēc # minūtēm tiks restartēts}}</translation>
<translation id="7565444033145385702">Lai aizsargātu savus datus, ļaujiet pārlūkā Enterprise Browser noņemt atļaujas vietnēm, ko pēdējā laikā neesat apmeklējis.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> instalēšanas programma</translation>
<translation id="761356813943268536">Pārlūkā Enterprise Browser tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="7617377681829253106">Pārlūkā Enterprise Browser ir veikti uzlabojumi</translation>
<translation id="7622753900276619808">Tagad pārlūkā Enterprise Browser ir pieejams vairāk funkciju.</translation>
<translation id="7649070708921625228">Palīdzība</translation>
<translation id="7658239707568436148">Atcelt</translation>
<translation id="7686590090926151193">Enterprise Browser nav jūsu noklusējuma pārlūks.</translation>
<translation id="7689606757190482937">Enterprise Browser sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="7699779824407626136">Enterprise Browser atjauninājums</translation>
<translation id="7716950018788545737">Uzdevumi ir pabeigti.</translation>
<translation id="77283119132245232">Nodrošina sistēmas izsekošanas pakalpojumus pārlūkā <ph name="BROWSER_NAME" />. Ja šis pakalpojums ir atspējots, pārlūka izveidotajos veiktspējas izsekošanas datos netiek ietverti sistēmas līmeņa notikumi, piemēram, konteksta maiņas un pavedienu gatavības notikumi.</translation>
<translation id="7745317241717453663">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Enterprise Browser kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="7786760609782648049">Pārlūka Enterprise Browser darbības paātrināšana</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Enterprise Browser Canary</translation>
<translation id="7803986347287457849">Neļaujiet personām, kurām ir piekļuve jūsu interneta datplūsmai, viegli skatīt jūsu apmeklētās vietnes. Enterprise Browser izmanto drošu savienojumu, lai meklētu vietnes IP adresi sistēmā DNS (domēnu nosaukumu sistēmā).</translation>
<translation id="7810005234485217901">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai varētu piekļūt.</translation>
<translation id="7828947555739565424">Šajā ierīcē jau pastāv Enterprise Browser profils ar šādu kontu.</translation>
<translation id="7845233973568007926">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē dators.</translation>
<translation id="7853661403199074278">Pielāgojiet pārlūku Enterprise Browser, lai piešķirtu tam jaunu izskatu.</translation>
<translation id="7859018312476869945">Kad rakstāt adreses joslā vai meklēšanas lodziņā, pārlūks Enterprise Browser nosūta ierakstīto tekstu jūsu noklusējuma meklētājprogrammai, lai iegūtu labākus ieteikumus. Inkognito režīmā šis iestatījums ir izslēgts.</translation>
<translation id="7867198900892795913">Nevarēja atjaunināt uz jaunāko Enterprise Browser versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7872446069773932638">Notiek lejupielāde... Atlikušais laiks: <ph name="SECONDS" /> sekunde(-es).</translation>
<translation id="7873537467422636035">Ja aizmirstat ieejas frāzi vai vēlaties mainīt šo iestatījumu, <ph name="BEGIN_LINK" />izdzēsiet Enterprise Browser datus savā kontā<ph name="END_LINK" />.</translation>
<translation id="7877212753140190672">Jautāt par šo attēlu</translation>
<translation id="7887929410013642057">Vienmēr rādīt MI režīma saīsnes</translation>
<translation id="7888981273428720788">Iestatīt Enterprise Browser kā noklusējuma pārlūku</translation>
<translation id="7934340546140346950">Pārlūkā Enterprise Browser nedrošie savienojumi tiek automātiski jaunināti uz HTTPS, ja iespējams.</translation>
<translation id="7937630085815544518">Operētājsistēmā Enterprise Browser iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7953047982688951904">Lejupielādējiet pārlūku Enterprise Browser savā tālrunī, lai nodrošinātu papildu aizsardzību, atrodoties ceļā.</translation>
<translation id="7975919845073681630">Šī ir Enterprise Browser papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="7997934263947464652">No nezināmiem avotiem iegūti paplašinājumi, lietotnes un motīvi var kaitēt ierīcei. Enterprise Browser komanda iesaka instalēt tos tikai no veikala <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />.</translation>
<translation id="8004582292198964060">Pārlūkprogramma</translation>
<translation id="8010081455002666927">Noteikt automātiski</translation>
<translation id="8013436988911883588">Tiklīdz pārlūkam Enterprise Browser tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="8031714377769448844">Piespraudiet pārlūku Enterprise Browser uzdevumu joslai, lai jebkurā laikā varētu tam ātri piekļūt.</translation>
<translation id="80471789339884597">Pateicamies, ka veicāt instalēšanu. Pirms <ph name="BUNDLE_NAME" /> izmantošanas ir jārestartē visas pārlūkprogrammas.</translation>
<translation id="8054112667659782652">Vienmēr rādīt funkcijas Attēlu meklēšana saīsni</translation>
<translation id="8077498902115777962">Atspējot Enterprise Browser darbību fonā lietotnēm</translation>
<translation id="80790299200510644">Attēlu meklēšana</translation>
<translation id="8086881907087796310">Instalēšana neizdevās, jo jūsu dators neatbilst minimālajām aparatūras prasībām.</translation>
<translation id="8096472344908884505"><ph name="PAGE_TITLE" /> — Enterprise Browser for Testing</translation>
<translation id="8105840573057009683">Pārlūkam Enterprise Browser ir nepieciešama atrašanās vietas atļauja šai vietnei.</translation>
<translation id="8118331347066725040">Sūtiet atsauksmes par meklēšanu, izmantojot Lens</translation>
<translation id="8133124826068723441">Enterprise Browser OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="813913629614996137">Notiek inicializēšana...</translation>
<translation id="81770708095080097">Šis fails ir bīstams, tāpēc Enterprise Browser to bloķēja.</translation>
<translation id="8177472873527554730">Nevar atrast saturu lapā</translation>
<translation id="8200109504272824693">Lai savā kontā (<ph name="USER_EMAIL" />) izmantotu un saglabātu Enterprise Browser datus, ievadiet ieejas frāzi.</translation>
<translation id="8221491193165283816">Parasti jūs bloķējat paziņojumus. Lai ļautu šai vietnei sūtīt jums paziņojumus, noklikšķiniet šeit.</translation>
<translation id="8223363452568144035">Lai izmantotu kameru, piešķiriet pārlūkam Enterprise Browser piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
<translation id="8232193495299001329">Enterprise Browser nevar pārbaudīt šī paplašinājuma izcelsmi, un, iespējams, tas nav drošs. Noņemiet to no pārlūka Enterprise Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp personas informāciju.</translation>
<translation id="8248265253516264921">Ja attēlam nav vērtīga apraksta, pārlūks Enterprise Browser mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="8254601181414348851">Vai pierakstīties pārlūkā Enterprise Browser, izmantojot jaunu profilu?</translation>
<translation id="8286943863733751221">Pārlūkā <ph name="BEGIN_LINK" />Enterprise Browser tiek rādīti brīdinājumi<ph name="END_LINK" /> par nedrošām vietnēm un lejupielādēm</translation>
<translation id="8295827201165805317">Pēdējā laikā šī vietne nav apmeklēta. Pārlūkā Enterprise Browser tika noņemta šāda atļauja: <ph name="PERMISSION" />.</translation>
<translation id="8313851650939857356">Palaišanas kļūda: <ph name="STARTUP_ERROR" />.</translation>
<translation id="8318772038038596122">Jūsu organizācija aizver pārlūku Enterprise Browser, ja tas <ph name="TIMEOUT_DURATION" /> netiek izmantots.</translation>
<translation id="8321888067342493336">Saglabāt kā attēlu</translation>
<translation id="8330519371938183845">Pierakstieties, lai sinhronizētu un personalizētu pārlūku Enterprise Browser visās savās ierīcēs.</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja Enterprise Browser</translation>
<translation id="8359544530202147897">Lai turpinātu izmantot Enterprise Browser datus savā Google kontā (<ph name="ACCOUNT_EMAIL" />), atjauniniet pārlūku Enterprise Browser.</translation>
<translation id="8360718212975266891">Lai saņemtu turpmākus Enterprise Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.</translation>
<translation id="8362914115861174987">Tulkot šādā valodā:</translation>
<translation id="8367705492654390392">Uzdodiet jebkādu jautājumu</translation>
<translation id="8370517070665726704">Autortiesības: <ph name="YEAR" /> Google LLC. Visas tiesības paturētas.</translation>
<translation id="8372327902843331129">Pierakstieties pārlūkā Enterprise Browser, lai varētu piekļūt parolēm un citiem datiem visās savās ierīcēs. Šī parole tiks saglabāta jūsu Google kontā pēc pierakstīšanās.</translation>
<translation id="837460953767177950">Pēc tam jums būs jārestartē pārlūks Enterprise Browser.</translation>
<translation id="8397248745433792218">Enterprise Browser iesaka to noņemt. <ph name="BEGIN_LINK" />Uzziniet vairāk par atbalstītajiem paplašinājumiem<ph name="END_LINK" />.</translation>
<translation id="8401454788024434101">Šī paplašinājuma publicēšanu atcēla izstrādātājs, un paplašinājums, iespējams, nav drošs. Noņemiet to no pārlūka Enterprise Browser, lai tas jūsu apmeklētajās vietnēs vairs nevarētu skatīt un mainīt jūsu datus, tostarp jūsu personas informāciju.</translation>
<translation id="8416884904046428725">Pārlūkā Enterprise Browser ir jāverificē jūsu identitāte, lai noteiktus datus varētu saglabāt jūsu Google kontā un izmantot visās jūsu ierīcēs. Ja izrakstīsieties tūlīt, šie dati tiks dzēsti.</translation>
<translation id="8417404458978023919">{0,plural, =1{Restartējiet pārlūku Enterprise Browser vienas dienas laikā}zero{Restartējiet pārlūku Enterprise Browser # dienu laikā}one{Restartējiet pārlūku Enterprise Browser # dienas laikā}other{Restartējiet pārlūku Enterprise Browser # dienu laikā}}</translation>
<translation id="8438543370129609977">Kad izmantojat funkciju Attēlu meklēšana, serverim tiek nosūtīts lapas nosaukums, URL un saturs, tostarp PDF faili. <ph name="LEARN_MORE" /></translation>
<translation id="8447525028100794994">Uzzināt vairāk par meklēšanu, izmantojot attēlu meklēšanu pārlūkā Enterprise Browser</translation>
<translation id="8453117565092476964">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Enterprise Browser vēlreiz.</translation>
<translation id="8458614432758743027">Pārlūka Enterprise Browser izmantošanai nepieciešama operētājsistēma Windows 10 vai jaunāka versija.</translation>
<translation id="8463672209299734063">Neobligāti: palīdziet uzlabot Enterprise Browser OS funkcijas un veiktspēju, automātiski nosūtot Google serveriem diagnostikas un lietojuma datus.</translation>
<translation id="8471947159125090285">Lai izmantotu un saglabātu Enterprise Browser datus savā Google kontā, apstipriniet savu identitāti.</translation>
<translation id="8482493977473846331">Tiek rādīti aicinājumi pierakstīties pārlūkā Enterprise Browser.</translation>
<translation id="8493179195440786826">Enterprise Browser versija ir novecojusi</translation>
<translation id="850264194101621529">Paldies, ka izvēlējāties Enterprise Browser kā noklusējuma pārlūku!</translation>
<translation id="8522801943730206384">Pārlūkprogrammā Enterprise Browser var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="8548787790260785208">Saņemiet brīdinājumu, ja pārlūkā Enterprise Browser tiek konstatēts, ka kāda no jūsu parolēm ir iekļauta publiskā datu aizsardzības pārkāpumā.</translation>
<translation id="8555465886620020932">Pakalpojuma kļūda: <ph name="SERVICE_ERROR" />.</translation>
<translation id="8556420416730706394">Varat piespraust funkciju Attēlu meklēšana, lai ērti tai piekļūtu. Sānu paneļa augšdaļā noklikšķiniet uz pogas “Piespraust”.</translation>
<translation id="856656450041460113">Meklēt valodu sarakstā</translation>
<translation id="8568283329061645092">Pārlūkprogrammā Enterprise Browser var pārbaudīt jūsu paroles, ja esat pierakstījies savā Google kontā.</translation>
<translation id="8576826849825683917">Pārlūku Enterprise Browser pārvalda vairākas organizācijas</translation>
<translation id="8586442755830160949">Autortiesības <ph name="YEAR" /> Enterprise Browser autori. Visas tiesības paturētas.</translation>
<translation id="8601359445272098721">Jaunums! Atlasot pogu “Tulkot ekrānu”, varat tulkot gan ekrānā redzamo tekstu, gan attēlus.</translation>
<translation id="8619360774459241877">Notiek Enterprise Browser palaišana...</translation>
<translation id="8624541899164515475">Iestatījumi; tiks atvērta jauna cilne.</translation>
<translation id="8648201657708811153">Enterprise Browser for Testing nevar iestatīt kā noklusējuma pārlūku.</translation>
<translation id="8697124171261953979">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Enterprise Browser vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="8704119203788522458">Šis ir jūsu Enterprise Browser</translation>
<translation id="8712637175834984815">Sapratu!</translation>
<translation id="8719993436687031146">Vai pierakstīties pārlūkā Enterprise Browser?</translation>
<translation id="8745263398357414606">Glabājiet visu pārlūkā Enterprise Browser</translation>
<translation id="8747073452963259673">meklēšanas apgabala apakšējais kreisais stūris: <ph name="LEFT" />% pa kreisi, <ph name="BOTTOM" />% apakšdaļā</translation>
<translation id="878572486461146056">Instalēšanas kļūda: administrators ir piemērojis grupas politiku, kas neļauj veikt instalēšanu: <ph name="INSTALL_ERROR" />.</translation>
<translation id="8796602469536043152">Pārlūkam Enterprise Browser ir nepieciešama atļauja piekļūt jūsu kamerai un mikrofonam šajā vietnē.</translation>
<translation id="8818550178040858407">Vai pierakstīties pārlūkā Enterprise Browser?</translation>
<translation id="8823401858233292222">Iestatīt Enterprise Browser kā noklusējuma pārlūku un piespraust to uzdevumu joslai</translation>
<translation id="8826492472752484139">Noklikšķiniet uz vienuma Paroļu pārvaldnieks.</translation>
<translation id="8833697763442816810">Enterprise Browser OS sistēma</translation>
<translation id="8852026904190808918">Šī valoda tiek izmantota, lai rādītu izvēlnes, iestatījumus, brīdinājumus un citu tekstu pārlūkā Enterprise Browser.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="8876044221123442390">Pievienot Enterprise Browser profilu</translation>
<translation id="8880203542552872219">Ja tā ir, lūdzu, rediģējiet saglabāto paroli pārlūkprogrammā Enterprise Browser, lai tā atbilstu jūsu jaunajai parolei.</translation>
<translation id="8891709362986793894">Saskaņā ar jūsu organizācijas politiku jums ir jāpierakstās pārlūkā Enterprise Browser.</translation>
<translation id="8907580949721785412">Enterprise Browser mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="8941642502866065432">Nevar atjaunināt Enterprise Browser</translation>
<translation id="897581876605952338">Enterprise Browser Enterprise logotips</translation>
<translation id="8988036198400390003">Pārvaldīt Enterprise Browser profilus</translation>
<translation id="9019929317751753759">Lai uzlabotu Enterprise Browser drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="9022552996538154597">Pierakstieties pārlūkā Enterprise Browser</translation>
<translation id="904366664621834601">Pārlūkā Enterprise Browser šī lejupielāde tika bloķēta, jo šajā arhīva failā ir ietverti citi faili, kas, iespējams, slēpj ļaunprātīgu programmatūru</translation>
<translation id="9062666675513499497">Automātiska pierakstīšanās pārlūkā Enterprise Browser, kad pierakstāties citos Google pakalpojumos</translation>
<translation id="9078733879136747090">Pārlūks Enterprise Browser tika automātiski aizvērts</translation>
<translation id="9089354809943900324">Enterprise Browser versija ir novecojusi.</translation>
<translation id="9093206154853821181">{0,plural, =1{Pārlūks Enterprise Browser pēc stundas tiks restartēts}zero{Pārlūks Enterprise Browser pēc # stundām tiks restartēts}one{Pārlūks Enterprise Browser pēc # stundas tiks restartēts}other{Pārlūks Enterprise Browser pēc # stundām tiks restartēts}}</translation>
<translation id="9106236359747881194">Atlasiet tekstu, ko meklēt</translation>
<translation id="9106612006984859720">Lai saņemtu turpmākus Enterprise Browser atjauninājumus, nepieciešama operētājsistēma Windows 10 vai jaunāka versija. Šajā datorā tiek izmantota operētājsistēma Windows 8.1.</translation>
<translation id="91086099826398415">Atvērt saiti jaunā Enterprise Browser &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9134482777260927479">Palīdzība mājasdarbos</translation>
<translation id="9148058034647219655">Iziet</translation>
<translation id="9155105544013854680">Turpiniet darbu no vietas, kur to pārtraucāt: pārlūkā Enterprise Browser var tikt atjaunotas jūsu cilnes ikreiz, kad to restartējat. Lai to ieslēgtu, pārejiet uz lapu</translation>
<translation id="9158494823179993217">Sistēmas administrators ir konfigurējis Enterprise Browser, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="9185526690718004400">Atkārtoti palaist, lai atjauninātu &amp;Enterprise Browser</translation>
<translation id="9190841055450128916">Enterprise Browser (mDNS ienākošie savienojumi)</translation>
<translation id="9206863043651638213">Iegūstiet vairāk, pierakstoties pārlūkā Enterprise Browser</translation>
<translation id="924957577793602335">Pielāgojiet pārlūku Enterprise Browser savām vajadzībām</translation>
<translation id="93478295209880648">Iespējams, Enterprise Browser nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="945522503751344254">Sūtīt atsauksmes</translation>
<translation id="965162752251293939">Kas izmanto pārlūku Enterprise Browser?</translation>
<translation id="967427899662692980">Visaugstākais Enterprise Browser drošības līmenis</translation>
<translation id="983803489796659991">Instalēšana neizdevās, jo atjauninājumu serverim nav nekādu jaukšanas datu lietojumprogrammai.</translation>
<translation id="985498048907240953">Izmantot Enterprise Browser, nepierakstoties kontā</translation>
<translation id="985602178874221306">Enterprise Browser autori</translation>
<translation id="989970834842471429">Atlasiet jebkuru tekstu vai attēlu, lai to meklētu, izmantojot funkciju Attēlu meklēšana</translation>
<translation id="992780518932311116">Lai izmantotu atrašanās vietas datus, piešķiriet pārlūkam Enterprise Browser piekļuvi <ph name="BEGIN_LINK" />sistēmas iestatījumos<ph name="END_LINK" />.</translation>
</translationbundle>